# metamodel_version: 1.12.0
# version: 1.5.0
BASE <https://w3id.org/lmodel/uco/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX uco-action: <https://ontology.unifiedcyberontology.org/uco/action/>
PREFIX uco-analysis: <https://ontology.unifiedcyberontology.org/uco/analysis/>
PREFIX uco-configuration: <https://ontology.unifiedcyberontology.org/uco/configuration/>
PREFIX uco-core: <https://ontology.unifiedcyberontology.org/uco/core/>
PREFIX uco-identity: <https://ontology.unifiedcyberontology.org/uco/identity/>
PREFIX uco-location: <https://ontology.unifiedcyberontology.org/uco/location/>
PREFIX uco-marking: <https://ontology.unifiedcyberontology.org/uco/marking/>
PREFIX uco-observable: <https://ontology.unifiedcyberontology.org/uco/observable/>
PREFIX uco-pattern: <https://ontology.unifiedcyberontology.org/uco/pattern/>
PREFIX uco-role: <https://ontology.unifiedcyberontology.org/uco/role/>
PREFIX uco-time: <https://ontology.unifiedcyberontology.org/uco/time/>
PREFIX uco-tool: <https://ontology.unifiedcyberontology.org/uco/tool/>
PREFIX uco-types: <https://ontology.unifiedcyberontology.org/uco/types/>
PREFIX uco-victim: <https://ontology.unifiedcyberontology.org/uco/victim/>
PREFIX coll: <http://purl.org/co/>
PREFIX linkml: <https://w3id.org/linkml/>
PREFIX collections: <https://w3id.org/lmodel/collections/>


linkml:String xsd:string

linkml:Integer xsd:integer

linkml:Boolean xsd:boolean

linkml:Float xsd:float

linkml:Double xsd:double

linkml:Decimal xsd:decimal

linkml:Time xsd:time

linkml:Date xsd:date

linkml:Datetime xsd:dateTime

linkml:DateOrDatetime linkml:DateOrDatetime

linkml:Uriorcurie IRI

linkml:Curie xsd:string

linkml:Uri IRI

linkml:Ncname xsd:string

linkml:Objectidentifier IRI

linkml:Nodeidentifier NONLITERAL

linkml:Jsonpointer xsd:string

linkml:Jsonpath xsd:string

linkml:Sparqlpath xsd:string

<UcoBase64Binary> xsd:base64Binary

<UcoByte> xsd:byte

<UcoDuration> xsd:duration

<UcoHexBinary> xsd:hexBinary

<UcoNonNegativeInteger> xsd:nonNegativeInteger

<UcoPositiveInteger> xsd:positiveInteger

<UcoUnsignedInt> xsd:unsignedInt

<UcoUnsignedShort> xsd:unsignedShort

<Time> uco-time:Time

<TimeRange> uco-time:TimeRange

<Timestamp> uco-time:Timestamp

<Identifier> uco-types:Identifier

<NativeFormatString> uco-types:NativeFormatString

<StructuredText> uco-types:StructuredText

<Account>  (
    CLOSED {
       (  $<Account_tes> (  &<ObservableObject_tes> ;
             rdf:type [ uco-observable:ObservableObject ] ?
          ) ;
          rdf:type [ uco-observable:Account ]
       )
    } OR @<DigitalAccount>
)

<AccountAuthenticationFacet> CLOSED {
    (  $<AccountAuthenticationFacet_tes> (  &<Facet_tes> ;
          rdf:type [ uco-core:Facet ] ? ;
          uco-observable:password @linkml:String ? ;
          uco-observable:passwordLastChanged @linkml:Datetime ? ;
          uco-observable:passwordType @linkml:String ?
       ) ;
       rdf:type [ uco-observable:AccountAuthenticationFacet ] ?
    )
}

<AccountFacet> CLOSED {
    (  $<AccountFacet_tes> (  &<Facet_tes> ;
          rdf:type [ uco-core:Facet ] ? ;
          uco-observable:accountIdentifier @linkml:String ? ;
          uco-observable:accountIssuer @<UcoObject> ? ;
          uco-observable:accountType @linkml:String ? ;
          uco-observable:expirationTime @linkml:Datetime ? ;
          uco-observable:isActive @linkml:Boolean ? ;
          uco-observable:observableCreatedTime @linkml:Datetime ? ;
          uco-observable:modifiedTime @linkml:Datetime ? ;
          uco-observable:owner @<UcoObject> ?
       ) ;
       rdf:type [ uco-observable:AccountFacet ] ?
    )
}

<Action>  (
    CLOSED {
       (  $<Action_tes> (  &<UcoObject_tes> ;
             rdf:type [ uco-core:UcoObject ] ? ;
             uco-action:actionCount @<UcoNonNegativeInteger> ? ;
             uco-action:actionStatus @linkml:String ? ;
             uco-action:endTime @linkml:Datetime ? ;
             uco-action:object @<UcoObject> * ;
             uco-action:startTime @linkml:Datetime ? ;
             uco-action:environment @<UcoObject> ? ;
             uco-action:error @<UcoObject> * ;
             uco-action:instrument @<UcoObject> * ;
             uco-action:location @<Location> * ;
             uco-action:participant @<UcoObject> * ;
             uco-action:performer @<UcoObject> ? ;
             uco-action:result @<UcoObject> * ;
             uco-action:subaction @<Action> *
          ) ;
          rdf:type [ uco-action:Action ]
       )
    } OR @<ActionLifecycle> OR @<ActionPattern> OR @<Analysis> OR @<Observation>
)

<ActionArgumentFacet> CLOSED {
    (  $<ActionArgumentFacet_tes> (  &<Facet_tes> ;
          rdf:type [ uco-core:Facet ] ? ;
          uco-action:value @linkml:String ;
          uco-action:argumentName @linkml:String
       ) ;
       rdf:type [ uco-action:ActionArgumentFacet ] ?
    )
}

<ActionEstimationFacet> CLOSED {
    (  $<ActionEstimationFacet_tes> (  &<Facet_tes> ;
          rdf:type [ uco-core:Facet ] ? ;
          uco-action:estimatedCost @linkml:String ? ;
          uco-action:estimatedEfficacy @linkml:String ? ;
          uco-action:estimatedImpact @linkml:String ? ;
          uco-action:objective @linkml:String ?
       ) ;
       rdf:type [ uco-action:ActionEstimationFacet ] ?
    )
}

<ActionFrequencyFacet> CLOSED {
    (  $<ActionFrequencyFacet_tes> (  &<Facet_tes> ;
          rdf:type [ uco-core:Facet ] ? ;
          uco-action:rate @linkml:Decimal ;
          uco-action:scale @linkml:String ;
          uco-action:trend @linkml:String ;
          uco-action:units @linkml:String
       ) ;
       rdf:type [ uco-action:ActionFrequencyFacet ] ?
    )
}

<ActionLifecycle> CLOSED {
    (  $<ActionLifecycle_tes> (  &<Action_tes> ;
          rdf:type [ uco-action:Action ] ? ;
          uco-action:phase @<ArrayOfAction> +
       ) ;
       rdf:type [ uco-action:ActionLifecycle ]
    )
}

<ActionPattern> CLOSED {
    (  $<ActionPattern_tes> (  &<Action_tes> ;
          rdf:type [ uco-action:Action ] ? ;
          &<Pattern_tes> ;
          rdf:type [ uco-pattern:Pattern ] ?
       ) ;
       rdf:type [ uco-action:ActionPattern ]
    )
}

<Adaptor> CLOSED {
    (  $<Adaptor_tes> (  &<Device_tes> ;
          rdf:type [ uco-observable:Device ] ?
       ) ;
       rdf:type [ uco-observable:Adaptor ]
    )
}

<Address>  (
    CLOSED {
       (  $<Address_tes> (  &<ObservableObject_tes> ;
             rdf:type [ uco-observable:ObservableObject ] ?
          ) ;
          rdf:type [ uco-observable:Address ]
       )
    } OR @<DigitalAddress> OR @<SocketAddress>
)

<AddressFacet> CLOSED {
    (  $<AddressFacet_tes> (  &<IdentityFacet_tes> ;
          rdf:type [ uco-identity:IdentityFacet ] ? ;
          uco-identity:address @<Location> ?
       ) ;
       rdf:type [ uco-identity:AddressFacet ] ?
    )
}

<AffiliationFacet> CLOSED {
    (  $<AffiliationFacet_tes> (  &<IdentityFacet_tes> ;
          rdf:type [ uco-identity:IdentityFacet ] ?
       ) ;
       rdf:type [ uco-identity:AffiliationFacet ] ?
    )
}

<AlternateDataStream> CLOSED {
    (  $<AlternateDataStream_tes> (  &<ObservableObject_tes> ;
          rdf:type [ uco-observable:ObservableObject ] ?
       ) ;
       rdf:type [ uco-observable:AlternateDataStream ]
    )
}

<AlternateDataStreamFacet> CLOSED {
    (  $<AlternateDataStreamFacet_tes> (  &<Facet_tes> ;
          rdf:type [ uco-core:Facet ] ? ;
          uco-observable:hashes @<Hash> ? ;
          uco-core:name @linkml:String ? ;
          uco-observable:size @linkml:Integer ?
       ) ;
       rdf:type [ uco-observable:AlternateDataStreamFacet ] ?
    )
}

<Analysis> CLOSED {
    (  $<Analysis_tes> (  &<Action_tes> ;
          rdf:type [ uco-action:Action ] ?
       ) ;
       rdf:type [ uco-analysis:Analysis ]
    )
}

<AnalyticResult> CLOSED {
    (  $<AnalyticResult_tes> (  &<Assertion_tes> ;
          rdf:type [ uco-core:Assertion ] ? ;
          uco-analysis:originatingAnalysis @<Analysis> ? ;
          uco-analysis:resultContent @<UcoObject> *
       ) ;
       rdf:type [ uco-analysis:AnalyticResult ]
    )
}

<AnalyticResultFacet>  (
    CLOSED {
       (  $<AnalyticResultFacet_tes> (  &<Facet_tes> ;
             rdf:type [ uco-core:Facet ] ?
          ) ;
          rdf:type [ uco-analysis:AnalyticResultFacet ] ?
       )
    } OR @<ArtifactClassificationResultFacet>
)

<AnalyticTool> CLOSED {
    (  $<AnalyticTool_tes> (  &<Tool_tes> ;
          rdf:type [ uco-tool:Tool ] ?
       ) ;
       rdf:type [ uco-tool:AnalyticTool ]
    )
}

<AndroidDevice> CLOSED {
    (  $<AndroidDevice_tes> (  &<Device_tes> ;
          rdf:type [ uco-observable:Device ] ?
       ) ;
       rdf:type [ uco-observable:AndroidDevice ]
    )
}

<AndroidDeviceFacet> CLOSED {
    (  $<AndroidDeviceFacet_tes> (  &<Facet_tes> ;
          rdf:type [ uco-core:Facet ] ? ;
          uco-observable:androidFingerprint @linkml:String ? ;
          uco-observable:androidID @<UcoHexBinary> ? ;
          uco-observable:androidVersion @linkml:String ? ;
          uco-observable:isADBRootEnabled @linkml:Boolean ? ;
          uco-observable:isSURootEnabled @linkml:Boolean ?
       ) ;
       rdf:type [ uco-observable:AndroidDeviceFacet ] ?
    )
}

<AndroidPhone> CLOSED {
    (  $<AndroidPhone_tes> (  &<SmartPhone_tes> ;
          rdf:type [ uco-observable:SmartPhone ] ? ;
          &<AndroidDevice_tes> ;
          rdf:type [ uco-observable:AndroidDevice ] ?
       ) ;
       rdf:type [ uco-observable:AndroidPhone ]
    )
}

<Annotation> CLOSED {
    (  $<Annotation_tes> (  &<Assertion_tes> ;
          rdf:type [ uco-core:Assertion ] ? ;
          uco-core:object @<UcoObject> +
       ) ;
       rdf:type [ uco-core:Annotation ]
    )
}

<AntennaFacet> CLOSED {
    (  $<AntennaFacet_tes> (  &<Facet_tes> ;
          rdf:type [ uco-core:Facet ] ? ;
          uco-observable:antennaHeight @linkml:Decimal ? ;
          uco-observable:azimuth @linkml:Decimal ? ;
          uco-observable:elevation @linkml:Decimal ? ;
          uco-observable:horizontalBeamWidth @linkml:Decimal ? ;
          uco-observable:signalStrength @linkml:Decimal ? ;
          uco-observable:skew @linkml:Decimal ?
       ) ;
       rdf:type [ uco-observable:AntennaFacet ] ?
    )
}

