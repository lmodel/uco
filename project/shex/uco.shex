    (  $<ArrayOfAction_tes> (  &<UcoInherentCharacterizationThing_tes> ;
          rdf:type [ uco-core:UcoInherentCharacterizationThing ] ? ;
          uco-action:action @<Action> +
       ) ;
       rdf:type [ uco-action:ArrayOfAction ] ?
    )
}

<ArtifactClassification> CLOSED {
    (  $<ArtifactClassification_tes> (  &<UcoInherentCharacterizationThing_tes> ;
          rdf:type [ uco-core:UcoInherentCharacterizationThing ] ? ;
