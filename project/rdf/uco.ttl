	linkml:base "int" ;
	linkml:definition_uri "https://w3id.org/lmodel/uco/UcoByte"^^xsd:anyURI ;
	linkml:description "XSD's byte: an integer from -128 to 127." ;
	linkml:maximum_value "127"^^linkml:\@id ;
	linkml:minimum_value "-128"^^linkml:\@id ;
	linkml:typeof <https://w3id.org/lmodel/uco/integer> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#byte"^^xsd:anyURI .
<https://w3id.org/lmodel/uco/uco_duration> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/uco/uco_core"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/uco/UcoDuration"^^xsd:anyURI ;
	linkml:description "XSD's duration: a length of time such as P1DT2H, in ISO 8601's form." ;
	linkml:pattern "^-?P(?!$)(\\d+Y)?(\\d+M)?(\\d+D)?(T(?!$)(\\d+H)?(\\d+M)?(\\d+(\\.\\d+)?S)?)?$" ;
	linkml:typeof <https://w3id.org/lmodel/uco/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#duration"^^xsd:anyURI .
