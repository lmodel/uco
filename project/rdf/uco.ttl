<https://w3id.org/lmodel/uco/uco_base64_binary> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/uco/uco_core"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/uco/UcoBase64Binary"^^xsd:anyURI ;
	linkml:description "XSD's base64Binary: binary data in the Base64 alphabet, padded with =." ;
	linkml:pattern "^([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" ;
	linkml:typeof <https://w3id.org/lmodel/uco/string> ;
