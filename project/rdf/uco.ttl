<https://w3id.org/lmodel/uco/Junction> a linkml:ClassDefinition ;
	skos:exactMatch "uco-observable:Junction"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/uco/uco_observable"^^xsd:anyURI ;
