<https://w3id.org/lmodel/uco/WindowsHook> a linkml:ClassDefinition ;
	skos:exactMatch "uco-observable:WindowsHook"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/uco/uco_observable"^^xsd:anyURI ;
	linkml:class_uri "https://ontology.unifiedcyberontology.org/uco/observable/WindowsHook"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/uco/WindowsHook"^^xsd:anyURI ;
	linkml:description "A Windows hook is a mechanism by which an application can intercept events, such as messages, mouse actions, and keystrokes within the Windows operating system. A function that intercepts a particular type of event is known as a hook procedure. A hook procedure can act on each event it receives, and then modify or discard the event. [based on https://docs.microsoft.com/en-us/windows/win32/winmsg/about-hooks]" ;
	linkml:is_a <https://w3id.org/lmodel/uco/ObservableObject> ;
	linkml:slot_usage _:c14n300 ;
	linkml:slots <https://w3id.org/lmodel/uco/createdBy> , <https://w3id.org/lmodel/uco/description> , <https://w3id.org/lmodel/uco/externalReference> , <https://w3id.org/lmodel/uco/hasChanged> , <https://w3id.org/lmodel/uco/hasFacet> , <https://w3id.org/lmodel/uco/id> , <https://w3id.org/lmodel/uco/modifiedTime> , <https://w3id.org/lmodel/uco/name> , <https://w3id.org/lmodel/uco/objectCreatedTime> , <https://w3id.org/lmodel/uco/objectMarking> , <https://w3id.org/lmodel/uco/objectStatus> , <https://w3id.org/lmodel/uco/specVersion> , <https://w3id.org/lmodel/uco/state> , <https://w3id.org/lmodel/uco/tag> , <https://w3id.org/lmodel/uco/type> .
<https://w3id.org/lmodel/uco/WindowsMailslot> a linkml:ClassDefinition ;
	skos:exactMatch "uco-observable:WindowsMailslot"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/uco/uco_observable"^^xsd:anyURI ;
	linkml:class_uri "https://ontology.unifiedcyberontology.org/uco/observable/WindowsMailslot"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/uco/WindowsMailslot"^^xsd:anyURI ;
	linkml:description "A Windows mailslot is is a pseudofile that resides in memory, and may be accessed using standard file functions. The data in a mailslot message can be in any form, but cannot be larger than 424 bytes when sent between computers. Unlike disk files, mailslots are temporary. When all handles to a mailslot are closed, the mailslot and all the data it contains are deleted. [based on https://docs.microsoft.com/en-us/windows/win32/ipc/about-mailslots]" ;
	linkml:is_a <https://w3id.org/lmodel/uco/ObservableObject> ;
	linkml:slot_usage _:c14n212 ;
	linkml:slots <https://w3id.org/lmodel/uco/createdBy> , <https://w3id.org/lmodel/uco/description> , <https://w3id.org/lmodel/uco/externalReference> , <https://w3id.org/lmodel/uco/hasChanged> , <https://w3id.org/lmodel/uco/hasFacet> , <https://w3id.org/lmodel/uco/id> , <https://w3id.org/lmodel/uco/modifiedTime> , <https://w3id.org/lmodel/uco/name> , <https://w3id.org/lmodel/uco/objectCreatedTime> , <https://w3id.org/lmodel/uco/objectMarking> , <https://w3id.org/lmodel/uco/objectStatus> , <https://w3id.org/lmodel/uco/specVersion> , <https://w3id.org/lmodel/uco/state> , <https://w3id.org/lmodel/uco/tag> , <https://w3id.org/lmodel/uco/type> .
<https://w3id.org/lmodel/uco/WindowsNetworkShare> a linkml:ClassDefinition ;
	skos:exactMatch "uco-observable:WindowsNetworkShare"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/uco/uco_observable"^^xsd:anyURI ;
	linkml:class_uri "https://ontology.unifiedcyberontology.org/uco/observable/WindowsNetworkShare"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/uco/WindowsNetworkShare"^^xsd:anyURI ;
	linkml:description "A Windows network share is a Windows computer resource made available from one host to other hosts on a computer network. It is a device or piece of information on a computer that can be remotely accessed from another computer transparently as if it were a resource in the local machine. Network sharing is made possible by inter-process communication over the network. [based on https://en.wikipedia.org/wiki/Shared_resource]" ;
	linkml:is_a <https://w3id.org/lmodel/uco/ObservableObject> ;
	linkml:slot_usage _:c14n244 ;
	linkml:slots <https://w3id.org/lmodel/uco/createdBy> , <https://w3id.org/lmodel/uco/description> , <https://w3id.org/lmodel/uco/externalReference> , <https://w3id.org/lmodel/uco/hasChanged> , <https://w3id.org/lmodel/uco/hasFacet> , <https://w3id.org/lmodel/uco/id> , <https://w3id.org/lmodel/uco/modifiedTime> , <https://w3id.org/lmodel/uco/name> , <https://w3id.org/lmodel/uco/objectCreatedTime> , <https://w3id.org/lmodel/uco/objectMarking> , <https://w3id.org/lmodel/uco/objectStatus> , <https://w3id.org/lmodel/uco/specVersion> , <https://w3id.org/lmodel/uco/state> , <https://w3id.org/lmodel/uco/tag> , <https://w3id.org/lmodel/uco/type> .
