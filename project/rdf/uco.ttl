	linkml:definition_uri "https://w3id.org/lmodel/uco/Pipe"^^xsd:anyURI ;
	linkml:description "A pipe is a mechanism for one-way inter-process communication using message passing where data written by one process is buffered by the operating system until it is read by the next process, and this uni-directional channel disappears when the processes are completed. [based on https://en.wikipedia.org/wiki/Pipeline_(Unix) ; https://en.wikipedia.org/wiki/Anonymous_pipe]" ;
	linkml:is_a <https://w3id.org/lmodel/uco/ObservableObject> ;
