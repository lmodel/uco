<https://w3id.org/lmodel/uco/Laptop> a linkml:ClassDefinition ;
	skos:exactMatch "uco-observable:Laptop"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/uco/uco_observable"^^xsd:anyURI ;
