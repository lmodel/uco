	linkml:definition_uri "https://w3id.org/lmodel/uco/WindowsHandle"^^xsd:anyURI ;
	linkml:description "A Windows handle is an abstract reference to a resource within the Windows operating system, such as a window, memory, an open file or a pipe. It is the mechanism by which applications interact with such resources in the Windows operating system." ;
	linkml:is_a <https://w3id.org/lmodel/uco/ObservableObject> ;
