	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:NamedPipe a owl:Class ;
	rdfs:label "NamedPipe" ;
	rdfs:subClassOf uco_linkml:FileSystemObject ;
	skos:definition "A named pipe is a mechanism for FIFO (first-in-first-out) inter-process communication. It is persisted as a filesystem object (that can be deleted like any other file), can be written to or read from by any process and exists beyond the lifespan of any process interacting with it (unlike simple anonymous pipes). [based on https://en.wikipedia.org/wiki/Named_pipe]" ;
	skos:exactMatch uco-observable:NamedPipe ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:NationalityFacet a owl:Class ;
	rdfs:label "NationalityFacet" ;
	rdfs:subClassOf uco_linkml:IdentityFacet ;
