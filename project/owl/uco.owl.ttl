	skos:definition "A network flow facet is a grouping of characteristics unique to a sequence of data transiting one or more digital network (a group of two or more computer systems linked together) connections. [based on https://www.webopedia.com/TERM/N/network.html]" ;
	skos:exactMatch uco-observable:NetworkFlowFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:NetworkInterface a owl:Class ;
	rdfs:label "NetworkInterface" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A network interface is a software or hardware interface between two pieces of equipment or protocol layers in a computer network." ;
	skos:exactMatch uco-observable:NetworkInterface ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:NetworkInterfaceFacet a owl:Class ;
