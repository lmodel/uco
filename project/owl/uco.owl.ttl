	skos:exactMatch uco-core:Facet ;
	skos:inScheme <https://w3id.org/lmodel/uco-core> .
uco_linkml:File a owl:Class ;
	rdfs:label "File" ;
	rdfs:subClassOf uco_linkml:FileSystemObject ;
	skos:definition "A file is a computer resource for recording data discretely on a computer storage device." ;
	skos:exactMatch uco-observable:File ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:FileFacet a owl:Class ;
	rdfs:label "FileFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1337 , _:c14n1365 , _:c14n1433 , _:c14n1521 , _:c14n1645 , _:c14n1694 , _:c14n1777 , _:c14n189 , _:c14n2149 , _:c14n2205 , _:c14n2339 , _:c14n2551 , _:c14n2653 , _:c14n2726 , _:c14n2892 , _:c14n2924 , _:c14n2946 , _:c14n3099 , _:c14n310 , _:c14n3245 , _:c14n3291 , _:c14n354 , _:c14n3717 , _:c14n3754 , _:c14n409 , _:c14n675 , _:c14n877 ;
	skos:definition "A file facet is a grouping of characteristics unique to the storage of a file (computer resource for recording data discretely in a computer storage device) on a file system (process that manages how and where data on a storage device is stored, accessed and managed). [based on https://en.wikipedia.org/Computer_file and https://www.techopedia.com/definition/5510/file-system]" ;
	skos:exactMatch uco-observable:FileFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:FilePermissionsFacet a owl:Class ;
	rdfs:label "FilePermissionsFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1016 , _:c14n3278 , _:c14n59 ;
	skos:definition "A file permissions facet is a grouping of characteristics unique to the access rights (e.g., view, change, navigate, execute) of a file on a file system." ;
	skos:exactMatch uco-observable:FilePermissionsFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:FileSystem a owl:Class ;
	rdfs:label "FileSystem" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A file system is the process that manages how and where data on a storage medium is stored, accessed and managed. [based on https://www.techopedia.com/definition/5510/file-system]" ;
	skos:exactMatch uco-observable:FileSystem ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:FileSystemFacet a owl:Class ;
	rdfs:label "FileSystemFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1138 , _:c14n2470 , _:c14n2641 , _:c14n3736 , _:c14n381 , _:c14n835 ;
	skos:definition "A file system facet is a grouping of characteristics unique to the process that manages how and where data on a storage medium is stored, accessed and managed. [based on https://www.techopedia.com/definition/5510/file-system]" ;
	skos:exactMatch uco-observable:FileSystemFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:FileSystemObject a owl:Class ;
	rdfs:label "FileSystemObject" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A file system object is an informational object represented and managed within a file system." ;
	skos:exactMatch uco-observable:FileSystemObject ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:ForumPost a owl:Class ;
	rdfs:label "ForumPost" ;
	rdfs:subClassOf uco_linkml:Message ;
	skos:definition "A forum post is message submitted by a user account to an online forum where the message content (and typically metadata including who posted it and when) is viewable by any party with viewing permissions on the forum." ;
	skos:exactMatch uco-observable:ForumPost ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:ForumPrivateMessage a owl:Class ;
	rdfs:label "ForumPrivateMessage" ;
	rdfs:subClassOf uco_linkml:Message ;
	skos:definition "A forum private message (aka PM or DM (direct message)) is a one-to-one message from one specific user account to another specific user account on an online form where transmission is managed by the online forum platform and the message is only viewable by the parties directly involved." ;
	skos:exactMatch uco-observable:ForumPrivateMessage ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:FragmentFacet a owl:Class ;
	rdfs:label "FragmentFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n12 , _:c14n1339 , _:c14n1356 , _:c14n3102 ;
	skos:definition "A fragment facet is a grouping of characteristics unique to an individual piece of the content of a file." ;
	skos:exactMatch uco-observable:FragmentFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:GPSCoordinatesFacet a owl:Class ;
	rdfs:label "GPSCoordinatesFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n177 , _:c14n1838 , _:c14n2090 , _:c14n2446 , _:c14n277 , _:c14n3088 , _:c14n3340 , _:c14n3403 , _:c14n501 , _:c14n575 , _:c14n853 , _:c14n967 ;
	skos:definition "A GPS coordinates facet is a grouping of characteristics unique to the expression of quantified dilution of precision (DOP) for an asserted set of geolocation coordinates typically associated with satellite navigation such as the Global Positioning System (GPS)." ;
	skos:exactMatch uco-location:GPSCoordinatesFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-location> .
uco_linkml:GUI a owl:Class ;
	rdfs:label "GUI" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A GUI is a graphical user interface that allows users to interact with electronic devices through graphical icons and audio indicators such as primary notation, instead of text-based user interfaces, typed command labels or text navigation. [based on https://en.wikipedia.org/wiki/Graphical_user_interface]" ;
	skos:exactMatch uco-observable:GUI ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:GamingConsole a owl:Class ;
	rdfs:label "GamingConsole" ;
	rdfs:subClassOf uco_linkml:Device ;
	skos:definition "A gaming console (video game console or game console) is an electronic system that connects to a display, typically a TV or computer monitor, for the primary purpose of playing video games." ;
	skos:exactMatch uco-observable:GamingConsole ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:GenericObservableObject a owl:Class ;
	rdfs:label "GenericObservableObject" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A generic observable object is an article or unit within the digital domain." ;
	skos:exactMatch uco-observable:GenericObservableObject ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:GeoLocationEntry a owl:Class ;
	rdfs:label "GeoLocationEntry" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A geolocation entry is a single application-specific geolocation entry." ;
	skos:exactMatch uco-observable:GeoLocationEntry ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:GeoLocationEntryFacet a owl:Class ;
	rdfs:label "GeoLocationEntryFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1307 , _:c14n1309 , _:c14n1878 , _:c14n2086 , _:c14n2349 , _:c14n3086 , _:c14n347 , _:c14n707 , _:c14n919 ;
	skos:definition "A geolocation entry facet is a grouping of characteristics unique to a single application-specific geolocation entry." ;
	skos:exactMatch uco-observable:GeoLocationEntryFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:GeoLocationLog a owl:Class ;
	rdfs:label "GeoLocationLog" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A geolocation log is a record containing geolocation tracks and/or geolocation entries." ;
	skos:exactMatch uco-observable:GeoLocationLog ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:GeoLocationLogFacet a owl:Class ;
	rdfs:label "GeoLocationLogFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1303 , _:c14n1713 , _:c14n2434 , _:c14n2921 , _:c14n3871 , _:c14n647 ;
	skos:definition "A geolocation log facet is a grouping of characteristics unique to a record containing geolocation tracks and/or geolocation entries." ;
	skos:exactMatch uco-observable:GeoLocationLogFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:GeoLocationTrack a owl:Class ;
	rdfs:label "GeoLocationTrack" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A geolocation track is a set of contiguous geolocation entries representing a path/track taken." ;
	skos:exactMatch uco-observable:GeoLocationTrack ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:GeoLocationTrackFacet a owl:Class ;
	rdfs:label "GeoLocationTrackFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1273 , _:c14n1510 , _:c14n1539 , _:c14n2301 , _:c14n2915 , _:c14n3032 , _:c14n3341 , _:c14n3609 , _:c14n3705 , _:c14n696 , _:c14n920 ;
	skos:definition "A geolocation track facet is a grouping of characteristics unique to a set of contiguous geolocation entries representing a path/track taken." ;
	skos:exactMatch uco-observable:GeoLocationTrackFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:GlobalFlagType a owl:Class ;
	rdfs:label "GlobalFlagType" ;
	rdfs:subClassOf uco_linkml:UcoInherentCharacterizationThing , _:c14n13 , _:c14n1808 , _:c14n2036 , _:c14n2309 , _:c14n2571 , _:c14n2628 , _:c14n267 , _:c14n3214 , _:c14n3393 , _:c14n437 , _:c14n970 ;
	skos:definition "A global flag type is a grouping of characteristics unique to the Windows systemwide global variable named NtGlobalFlag that enables various internal debugging, tracing, and validation support in the operating system. [based on \"Windows Global Flags, Chapter 3: System Mechanisms of Windows Internals by Solomon, Russinovich, and Ionescu]" ;
	skos:exactMatch uco-observable:GlobalFlagType ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:GranularMarking a owl:Class ;
	rdfs:label "GranularMarking" ;
	rdfs:subClassOf uco_linkml:UcoInherentCharacterizationThing , _:c14n1922 , _:c14n2031 , _:c14n3836 , _:c14n921 ;
	skos:definition "A granular marking is a grouping of characteristics unique to specification of marking definitions (restrictions, permissions, and other guidance for how data can be used and shared) that apply to particular portions of a particular UCO object." ;
	skos:exactMatch uco-marking:GranularMarking ;
	skos:inScheme <https://w3id.org/lmodel/uco-marking> .
uco_linkml:Grouping a owl:Class ;
	rdfs:label "Grouping" ;
	rdfs:subClassOf uco_linkml:ContextualCompilation , _:c14n1254 , _:c14n3574 ;
	skos:definition "A grouping is a compilation of referenced UCO content with a shared context." ;
	skos:exactMatch uco-core:Grouping ;
	skos:inScheme <https://w3id.org/lmodel/uco-core> .
uco_linkml:HTTPConnection a owl:Class ;
	rdfs:label "HTTPConnection" ;
	rdfs:subClassOf uco_linkml:NetworkConnection ;
	skos:definition "An HTTP connection is network connection that is conformant to the Hypertext Transfer Protocol (HTTP) standard." ;
	skos:exactMatch uco-observable:HTTPConnection ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:HTTPConnectionFacet a owl:Class ;
	rdfs:label "HTTPConnectionFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1189 , _:c14n1213 , _:c14n1258 , _:c14n1485 , _:c14n2050 , _:c14n2207 , _:c14n2264 , _:c14n2383 , _:c14n2871 , _:c14n2934 , _:c14n3267 , _:c14n3279 , _:c14n3524 , _:c14n3665 , _:c14n3850 , _:c14n443 , _:c14n491 , _:c14n87 ;
	skos:definition "An HTTP connection facet is a grouping of characteristics unique to portions of a network connection that are conformant to the Hypertext Transfer Protocol (HTTP) standard." ;
	skos:exactMatch uco-observable:HTTPConnectionFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:Hash a owl:Class ;
	rdfs:label "Hash" ;
	rdfs:subClassOf uco_linkml:UcoInherentCharacterizationThing , _:c14n1044 , _:c14n1598 , _:c14n1780 , _:c14n193 , _:c14n2974 , _:c14n3887 ;
	skos:definition "A hash is a grouping of characteristics unique to the result of applying a mathematical algorithm that maps data of arbitrary size to a bit string (the 'hash') and is a one-way function, that is, a function which is practically infeasible to invert. This is commonly used for integrity checking of data. [based on https://en.wikipedia.org/wiki/Cryptographic_hash_function]" ;
	skos:exactMatch uco-types:Hash ;
	skos:inScheme <https://w3id.org/lmodel/uco-types> .
uco_linkml:Hostname a owl:Class ;
	rdfs:label "Hostname" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A hostname is a label that is assigned to a device connected to a computer network and that is used to identify the device in various forms of electronic communication, such as the World Wide Web. A hostname may be a domain name, if it is properly organized into the domain name system. A domain name may be a hostname if it has been assigned to an Internet host and associated with the host's IP address. [based on https://en.wikipedia.org/wiki/Hostname]" ;
	skos:exactMatch uco-observable:Hostname ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:ICCID a owl:DatatypeProperty ;
	rdfs:label "ICCID" ;
	rdfs:range xsd:string ;
	skos:definition "Integrated circuit card identifier (http://www.itu.int/)." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:ICMPConnection a owl:Class ;
	rdfs:label "ICMPConnection" ;
	rdfs:subClassOf uco_linkml:NetworkConnection ;
	skos:definition "An ICMP connection is a network connection that is conformant to the Internet Control Message Protocol (ICMP) standard." ;
	skos:exactMatch uco-observable:ICMPConnection ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:ICMPConnectionFacet a owl:Class ;
	rdfs:label "ICMPConnectionFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1644 , _:c14n1653 , _:c14n2252 , _:c14n912 ;
	skos:definition "An ICMP connection facet is a grouping of characteristics unique to portions of a network connection that are conformant to the Internet Control Message Protocol (ICMP) standard." ;
	skos:exactMatch uco-observable:ICMPConnectionFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:IComHandlerActionType a owl:Class ;
	rdfs:label "IComHandlerActionType" ;
	rdfs:subClassOf uco_linkml:UcoInherentCharacterizationThing , _:c14n1060 , _:c14n1869 , _:c14n2177 , _:c14n2691 , _:c14n3334 , _:c14n868 ;
	skos:definition "An IComHandler action type is a grouping of characteristics unique to a Windows Task-related action that fires a Windows COM handler (smart code in the client address space that can optimize calls between a client and server). [based on https://docs.microsoft.com/en-us/windows/win32/taskschd/comhandleraction]" ;
	skos:exactMatch uco-observable:IComHandlerActionType ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:IExecActionType a owl:Class ;
	rdfs:label "IExecActionType" ;
	rdfs:subClassOf uco_linkml:UcoInherentCharacterizationThing , _:c14n1304 , _:c14n2436 , _:c14n2448 , _:c14n2509 , _:c14n2615 , _:c14n2712 , _:c14n2853 , _:c14n3083 , _:c14n3231 , _:c14n895 , _:c14n934 ;
	skos:definition "An IExec action type is a grouping of characteristics unique to an action that executes a command-line operation on a Windows operating system. [based on https://docs.microsoft.com/en-us/windows/win32/api/taskschd/nn-taskschd-iexecaction?redirectedfrom=MSDN]" ;
	skos:exactMatch uco-observable:IExecActionType ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:IMEI a owl:DatatypeProperty ;
	rdfs:label "IMEI" ;
	rdfs:range xsd:string ;
	skos:definition "International Mobile Equipment Identity (IMEI)." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:IMSI a owl:DatatypeProperty ;
	rdfs:label "IMSI" ;
	rdfs:range xsd:string ;
	skos:definition "An International Mobile Subscriber Identity (IMSI) is a unique identification associated with all GSM and UMTS network mobile phone users. It is stored as a 64-bit field in the SIM inside the phone and is sent by the phone to the network." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:IPAddress a owl:Class ;
	rdfs:label "IPAddress" ;
	rdfs:subClassOf uco_linkml:DigitalAddress ;
	skos:definition "An IP address is an Internet Protocol (IP) standards conformant identifier assigned to a device to enable routing and management of IP standards conformant communication to or from that device." ;
	skos:exactMatch uco-observable:IPAddress ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:IPAddressFacet a owl:Class ;
	rdfs:label "IPAddressFacet" ;
	rdfs:subClassOf uco_linkml:DigitalAddressFacet ;
	skos:definition "An IP address facet is a grouping of characteristics unique to an Internet Protocol (IP) standards conformant identifier assigned to a device to enable routing and management of IP standards conformant communication to or from that device." ;
	skos:exactMatch uco-observable:IPAddressFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:IPNetmask a owl:Class ;
	rdfs:label "IPNetmask" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "An IP netmask is a 32-bit 'mask' used to divide an IP address into subnets and specify the network's available hosts." ;
	skos:exactMatch uco-observable:IPNetmask ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:IPhone a owl:Class ;
	rdfs:label "IPhone" ;
	rdfs:subClassOf uco_linkml:AppleDevice , uco_linkml:SmartPhone ;
	skos:definition "An iPhone is a smart phone that applies the iOS mobile operating system." ;
	skos:exactMatch uco-observable:IPhone ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:IPv4Address a owl:Class ;
	rdfs:label "IPv4Address" ;
	rdfs:subClassOf uco_linkml:IPAddress ;
	skos:definition "An IPv4 (Internet Protocol version 4) address is an IPv4 standards conformant identifier assigned to a device to enable routing and management of IPv4 standards conformant communication to or from that device." ;
	skos:exactMatch uco-observable:IPv4Address ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:IPv4AddressFacet a owl:Class ;
	rdfs:label "IPv4AddressFacet" ;
	rdfs:subClassOf uco_linkml:IPAddressFacet ;
	skos:definition "An IPv4 (Internet Protocol version 4) address facet is a grouping of characteristics unique to an IPv4 standards conformant identifier assigned to a device to enable routing and management of IPv4 standards conformant communication to or from that device." ;
	skos:exactMatch uco-observable:IPv4AddressFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:IPv6Address a owl:Class ;
	rdfs:label "IPv6Address" ;
	rdfs:subClassOf uco_linkml:IPAddress ;
	skos:definition "An IPv6 (Internet Protocol version 6) address is an IPv6 standards conformant identifier assigned to a device to enable routing and management of IPv6 standards conformant communication to or from that device." ;
	skos:exactMatch uco-observable:IPv6Address ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:IPv6AddressFacet a owl:Class ;
	rdfs:label "IPv6AddressFacet" ;
	rdfs:subClassOf uco_linkml:IPAddressFacet ;
	skos:definition "An IPv6 (Internet Protocol version 6) address facet is a grouping of characteristics unique to an IPv6 standards conformant identifier assigned to a device to enable routing and management of IPv6 standards conformant communication to or from that device." ;
	skos:exactMatch uco-observable:IPv6AddressFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:IShowMessageActionType a owl:Class ;
	rdfs:label "IShowMessageActionType" ;
	rdfs:subClassOf uco_linkml:UcoInherentCharacterizationThing , _:c14n1667 , _:c14n1874 , _:c14n2296 , _:c14n3 , _:c14n3161 , _:c14n3307 ;
	skos:definition "An IShow message action type is a grouping of characteristics unique to an action that shows a message box when a task is activate. [based on https://docs.microsoft.com/en-us/windows/win32/api/taskschd/nn-taskschd-ishowmessageaction?redirectedfrom=MSDN]" ;
	skos:exactMatch uco-observable:IShowMessageActionType ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:IdentifierFacet a owl:Class ;
	rdfs:label "IdentifierFacet" ;
	rdfs:subClassOf uco_linkml:IdentityFacet ;
	skos:definition "Identifier is a grouping of characteristics unique to information that uniquely and specifically identities an entity." ;
	skos:exactMatch uco-identity:IdentifierFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-identity> .
uco_linkml:Identity a owl:Class ;
	rdfs:label "Identity" ;
	rdfs:subClassOf uco_linkml:IdentityAbstraction ;
	skos:definition "An identity is a grouping of identifying characteristics unique to an individual or organization." ;
	skos:exactMatch uco-identity:Identity ;
	skos:inScheme <https://w3id.org/lmodel/uco-identity> .
uco_linkml:IdentityAbstraction a owl:Class ;
	rdfs:label "IdentityAbstraction" ;
	rdfs:subClassOf uco_linkml:UcoObject ;
	skos:definition "An identity abstraction is a grouping of identifying characteristics unique to an individual or organization. This class is an ontological structural abstraction for this concept. Implementations of this concept should utilize the identity:Identity class." ;
	skos:exactMatch uco-core:IdentityAbstraction ;
	skos:inScheme <https://w3id.org/lmodel/uco-core> .
uco_linkml:IdentityFacet a owl:Class ;
	rdfs:label "IdentityFacet" ;
	rdfs:subClassOf uco_linkml:Facet ;
	skos:definition "An identity facet is a grouping of characteristics unique to a particular aspect of an identity." ;
	skos:exactMatch uco-identity:IdentityFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-identity> .
uco_linkml:Image a owl:Class ;
	rdfs:label "Image" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "An image is a complete copy of a hard disk, memory, or other digital media." ;
	skos:exactMatch uco-observable:Image ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:ImageFacet a owl:Class ;
	rdfs:label "ImageFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1195 , _:c14n2554 , _:c14n592 ;
	skos:definition "An image facet is a grouping of characteristics unique to a complete copy of a hard disk, memory, or other digital media." ;
	skos:exactMatch uco-observable:ImageFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:ImproperDictionary a owl:Class ;
	rdfs:label "ImproperDictionary" ;
	rdfs:subClassOf uco_linkml:Dictionary , _:c14n2465 , _:c14n852 ;
	skos:definition "UCO 1.5.0 declares the class uco-types:ImproperDictionary without a definition." ;
	skos:exactMatch uco-types:ImproperDictionary ;
	skos:inScheme <https://w3id.org/lmodel/uco-types> .
uco_linkml:InstantMessagingAddress a owl:Class ;
	rdfs:label "InstantMessagingAddress" ;
	rdfs:subClassOf uco_linkml:DigitalAddress ;
	skos:definition "UCO 1.5.0 declares the class uco-observable:InstantMessagingAddress without a definition." ;
	skos:exactMatch uco-observable:InstantMessagingAddress ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:InstantMessagingAddressFacet a owl:Class ;
	rdfs:label "InstantMessagingAddressFacet" ;
	rdfs:subClassOf uco_linkml:DigitalAddressFacet ;
	skos:definition "An instant messaging address facet is a grouping of characteristics unique to an identifier assigned to enable routing and management of instant messaging digital communication." ;
	skos:exactMatch uco-observable:InstantMessagingAddressFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:Item a owl:Class ;
	rdfs:label "Item" ;
	rdfs:subClassOf uco_linkml:UcoObject ;
	skos:definition "An item is a distinct article or unit." ;
	skos:exactMatch uco-core:Item ;
	skos:inScheme <https://w3id.org/lmodel/uco-core> .
uco_linkml:Junction a owl:Class ;
	rdfs:label "Junction" ;
	rdfs:subClassOf uco_linkml:FileSystemObject ;
	skos:definition "A junction is a specific NTFS (New Technology File System) reparse point to redirect a directory access to another directory which can be on the same volume or another volume. A junction is similar to a directory symbolic link but may differ on whether they are processed on the local system or on the remote file server. [based on https://jp-andre.pagesperso-orange.fr/junctions.html]" ;
	skos:exactMatch uco-observable:Junction ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:LanguagesFacet a owl:Class ;
	rdfs:label "LanguagesFacet" ;
	rdfs:subClassOf uco_linkml:IdentityFacet ;
	skos:definition "Languages is a grouping of characteristics unique to specific syntactically and grammatically standardized forms of communication (human or computer) in which an entity has proficiency (comprehends, speaks, reads, or writes)." ;
	skos:exactMatch uco-identity:LanguagesFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-identity> .
uco_linkml:Laptop a owl:Class ;
	rdfs:label "Laptop" ;
	rdfs:subClassOf uco_linkml:Computer ;
	skos:definition "A laptop, laptop computer, or notebook computer is a small, portable personal computer with a screen and alphanumeric keyboard. These typically have a clam shell form factor with the screen mounted on the inside of the upper lid and the keyboard on the inside of the lower lid, although 2-in-1 PCs with a detachable keyboard are often marketed as laptops or as having a laptop mode. (Devices categorized by their manufacturer as a Laptop)" ;
	skos:exactMatch uco-observable:Laptop ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:LatLongCoordinatesFacet a owl:Class ;
	rdfs:label "LatLongCoordinatesFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n2021 , _:c14n2240 , _:c14n2960 , _:c14n3666 , _:c14n3753 , _:c14n447 , _:c14n595 , _:c14n627 , _:c14n770 ;
	skos:definition "A lat long coordinates facet is a grouping of characteristics unique to the expression of a geolocation as the intersection of specific latitude, longitude, and altitude values." ;
	skos:exactMatch uco-location:LatLongCoordinatesFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-location> .
uco_linkml:Library a owl:Class ;
	rdfs:label "Library" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A library is a suite of data and programming code that is used to develop software programs and applications. [based on https://www.techopedia.com/definition/3828/software-library]" ;
	skos:exactMatch uco-observable:Library ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:LibraryFacet a owl:Class ;
	rdfs:label "LibraryFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1566 , _:c14n171 , _:c14n68 ;
	skos:definition "A library facet is a grouping of characteristics unique to a suite of data and programming code that is used to develop software programs and applications. [based on https://www.techopedia.com/definition/3828/software-library]" ;
	skos:exactMatch uco-observable:LibraryFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:LibraryType a owl:Class ;
	rdfs:label "LibraryType" ;
	rdfs:subClassOf uco_linkml:UcoInherentCharacterizationThing , _:c14n1515 , _:c14n20 , _:c14n2546 , _:c14n2559 , _:c14n295 , _:c14n60 ;
	skos:definition "A library type is a grouping of characteristics unique to a collection of resources incorporated into the build of a software." ;
	skos:exactMatch uco-tool:LibraryType ;
	skos:inScheme <https://w3id.org/lmodel/uco-tool> .
uco_linkml:LicenseMarking dcterms:title "License Marking" ;
	a owl:Class ;
	rdfs:label "LicenseMarking" ;
	rdfs:subClassOf uco_linkml:MarkingModel , _:c14n154 , _:c14n1571 , _:c14n2123 , _:c14n3235 , _:c14n505 , _:c14n839 ;
	skos:definition "A license marking is a grouping of characteristics unique to the expression of data marking definitions (restrictions, permissions, and other guidance for how data can be used and shared) to convey details of license restrictions that apply to the data." ;
	skos:exactMatch uco-marking:LicenseMarking ;
	skos:inScheme <https://w3id.org/lmodel/uco-marking> .
uco_linkml:List a owl:Class ;
	rdfs:label "List" ;
	rdfs:subClassOf uco_linkml:Bag , _:c14n1045 , _:c14n1223 , _:c14n1414 , _:c14n1824 , _:c14n2065 , _:c14n3505 , _:c14n3819 , _:c14n3852 ;
	skos:definition "A collection whose items come in order, one after another." ;
	skos:exactMatch coll:List ;
	skos:inScheme <https://w3id.org/lmodel/uco-co> .
uco_linkml:ListItem a owl:Class ;
	rdfs:label "ListItem" ;
	rdfs:subClassOf uco_linkml:CoItem , _:c14n1183 , _:c14n1340 , _:c14n1693 , _:c14n244 , _:c14n3776 ;
	skos:definition "An item of a list, which has a place in the list's order." ;
	skos:exactMatch coll:ListItem ;
	skos:inScheme <https://w3id.org/lmodel/uco-co> .
uco_linkml:Location a owl:Class ;
	rdfs:label "Location" ;
	rdfs:subClassOf uco_linkml:UcoObject ;
	skos:definition "A location is a geospatial place, site, or position." ;
	skos:exactMatch uco-location:Location ;
	skos:inScheme <https://w3id.org/lmodel/uco-location> .
uco_linkml:LogicalPattern a owl:Class ;
	rdfs:label "LogicalPattern" ;
	rdfs:subClassOf uco_linkml:Pattern , _:c14n1983 , _:c14n3854 , _:c14n986 ;
	skos:definition "A logical pattern is a grouping of characteristics unique to an informational pattern expressed via a structured pattern expression following the rules of logic." ;
	skos:exactMatch uco-pattern:LogicalPattern ;
	skos:inScheme <https://w3id.org/lmodel/uco-pattern> .
uco_linkml:MACAddress a owl:Class ;
	rdfs:label "MACAddress" ;
	rdfs:subClassOf uco_linkml:DigitalAddress ;
	skos:definition "A MAC address is a media access control standards conformant identifier assigned to a network interface to enable routing and management of communications at the data link layer of a network segment." ;
	skos:exactMatch uco-observable:MACAddress ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:MACAddressFacet a owl:Class ;
	rdfs:label "MACAddressFacet" ;
	rdfs:subClassOf uco_linkml:DigitalAddressFacet ;
	skos:definition "A MAC address facet is a grouping of characteristics unique to a media access control standards conformant identifier assigned to a network interface to enable routing and management of communications at the data link layer of a network segment." ;
	skos:exactMatch uco-observable:MACAddressFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:MSISDN a owl:DatatypeProperty ;
	rdfs:label "MSISDN" ;
	rdfs:range xsd:string ;
	skos:definition "Mobile Station International Subscriber Directory Number (MSISDN) is a number used to identify a mobile phone number internationally. MSISDN is defined by the E.164 numbering plan. This number includes a country code and a National Destination Code which identifies the subscriber's operator." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:MSISDNType a owl:DatatypeProperty ;
	rdfs:label "MSISDNType" ;
	rdfs:range xsd:string ;
	rdfs:subPropertyOf uco_linkml:informalType ;
	skos:definition "???." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:MaliciousRole a owl:Class ;
	rdfs:label "MaliciousRole" ;
	rdfs:subClassOf uco_linkml:Role ;
	skos:definition "A malicious role is a role with malevolent intent." ;
	skos:exactMatch uco-role:MaliciousRole ;
	skos:inScheme <https://w3id.org/lmodel/uco-role> .
uco_linkml:MaliciousTool a owl:Class ;
	rdfs:label "MaliciousTool" ;
	rdfs:subClassOf uco_linkml:Tool ;
	skos:definition "A malicious tool is an artifact of hardware and/or software utilized to accomplish a malevolent task or purpose." ;
	skos:exactMatch uco-tool:MaliciousTool ;
	skos:inScheme <https://w3id.org/lmodel/uco-tool> .
uco_linkml:MarkingDefinition a owl:Class ;
	rdfs:label "MarkingDefinition" ;
	rdfs:subClassOf uco_linkml:MarkingDefinitionAbstraction , _:c14n1987 , _:c14n2009 , _:c14n2845 , _:c14n3749 , _:c14n572 ;
	skos:definition "A marking definition is a grouping of characteristics unique to the expression of a specific data marking conveying restrictions, permissions, and other guidance for how marked data can be used and shared." ;
	skos:exactMatch uco-marking:MarkingDefinition ;
	skos:inScheme <https://w3id.org/lmodel/uco-marking> .
uco_linkml:MarkingDefinitionAbstraction a owl:Class ;
	rdfs:label "MarkingDefinitionAbstraction" ;
	rdfs:subClassOf uco_linkml:UcoObject ;
	skos:definition "A marking definition abstraction is a grouping of characteristics unique to the expression of a specific data marking conveying restrictions, permissions, and other guidance for how marked data can be used and shared. This class is an ontological structural abstraction for this concept. Implementations of this concept should utilize the marking:MarkingDefinition class." ;
	skos:exactMatch uco-core:MarkingDefinitionAbstraction ;
	skos:inScheme <https://w3id.org/lmodel/uco-core> .
uco_linkml:MarkingModel a owl:Class ;
	rdfs:label "MarkingModel" ;
	rdfs:subClassOf uco_linkml:UcoInherentCharacterizationThing ;
	skos:definition "A marking model is a grouping of characteristics unique to the expression of a particular form of data marking definitions (restrictions, permissions, and other guidance for how data can be used and shared)." ;
	skos:exactMatch uco-marking:MarkingModel ;
	skos:inScheme <https://w3id.org/lmodel/uco-marking> .
uco_linkml:Memory a owl:Class ;
	rdfs:label "Memory" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "Memory is a particular region of temporary information storage (e.g., RAM (random access memory), ROM (read only memory)) on a digital device." ;
	skos:exactMatch uco-observable:Memory ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:MemoryFacet a owl:Class ;
	rdfs:label "MemoryFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1105 , _:c14n1208 , _:c14n1467 , _:c14n1497 , _:c14n1607 , _:c14n1735 , _:c14n1800 , _:c14n2130 , _:c14n238 , _:c14n2766 , _:c14n2837 , _:c14n3015 , _:c14n3070 , _:c14n3265 , _:c14n348 , _:c14n3895 , _:c14n3903 , _:c14n3904 , _:c14n585 , _:c14n758 , _:c14n795 , _:c14n826 ;
	skos:definition "A memory facet is a grouping of characteristics unique to a particular region of temporary information storage (e.g., RAM (random access memory), ROM (read only memory)) on a digital device." ;
	skos:exactMatch uco-observable:MemoryFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:Message a owl:Class ;
	rdfs:label "Message" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A message is a discrete unit of electronic communication intended by the source for consumption by some recipient or group of recipients. [based on https://en.wikipedia.org/wiki/Message]" ;
	skos:exactMatch uco-observable:Message ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:MessageFacet a owl:Class ;
	rdfs:label "MessageFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1154 , _:c14n1347 , _:c14n1445 , _:c14n1468 , _:c14n1638 , _:c14n1767 , _:c14n2083 , _:c14n209 , _:c14n2288 , _:c14n2329 , _:c14n236 , _:c14n2443 , _:c14n2474 , _:c14n2931 , _:c14n3385 , _:c14n3554 , _:c14n359 , _:c14n3697 , _:c14n3839 , _:c14n6 , _:c14n718 , _:c14n908 , _:c14n926 ;
	skos:definition "A message facet is a grouping of characteristics unique to a discrete unit of electronic communication intended by the source for consumption by some recipient or group of recipients. [based on https://en.wikipedia.org/wiki/Message]" ;
	skos:exactMatch uco-observable:MessageFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:MessageThread a owl:Class ;
	rdfs:label "MessageThread" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A message thread is a running commentary of electronic messages pertaining to one topic or question." ;
	skos:exactMatch uco-observable:MessageThread ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:MessageThreadFacet a owl:Class ;
	rdfs:label "MessageThreadFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1058 , _:c14n1419 , _:c14n1519 , _:c14n1582 , _:c14n2150 , _:c14n2491 , _:c14n2823 , _:c14n3124 ;
	skos:definition "A message thread facet is a grouping of characteristics unique to a running commentary of electronic messages pertaining to one topic or question." ;
	skos:exactMatch uco-observable:MessageThreadFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:MftRecordFacet a owl:Class ;
	rdfs:label "MftRecordFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1050 , _:c14n1063 , _:c14n1126 , _:c14n1381 , _:c14n1444 , _:c14n1449 , _:c14n1986 , _:c14n1996 , _:c14n205 , _:c14n2107 , _:c14n215 , _:c14n2158 , _:c14n2270 , _:c14n2303 , _:c14n2417 , _:c14n2547 , _:c14n2606 , _:c14n2637 , _:c14n2731 , _:c14n2738 , _:c14n2842 , _:c14n3043 , _:c14n305 , _:c14n3073 , _:c14n3111 , _:c14n3114 , _:c14n3183 , _:c14n3273 , _:c14n3294 , _:c14n3360 , _:c14n3466 , _:c14n3490 , _:c14n358 , _:c14n3701 , _:c14n3864 , _:c14n620 ;
	skos:definition "An MFT record facet is a grouping of characteristics unique to the details of a single file as managed in an NTFS (new technology filesystem) master file table (which is a collection of information about all files on an NTFS filesystem). [based on https://docs.microsoft.com/en-us/windows/win32/devnotes/master-file-table]" ;
	skos:exactMatch uco-observable:MftRecordFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:MimePartType a owl:Class ;
	rdfs:label "MimePartType" ;
	rdfs:subClassOf uco_linkml:UcoInherentCharacterizationThing , _:c14n1175 , _:c14n1373 , _:c14n1870 , _:c14n1873 , _:c14n2066 , _:c14n2087 , _:c14n2353 , _:c14n2541 , _:c14n3342 , _:c14n336 , _:c14n3712 , _:c14n534 ;
	skos:definition "A mime part type is a grouping of characteristics unique to a component of a multi-part email body." ;
	skos:exactMatch uco-observable:MimePartType ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:MobileAccount a owl:Class ;
	rdfs:label "MobileAccount" ;
	rdfs:subClassOf uco_linkml:DigitalAccount ;
	skos:definition "A mobile account is an arrangement with an entity to enable and control the provision of some capability or service on a portable computing device. [based on https://www.lexico.com/definition/mobile_device]" ;
	skos:exactMatch uco-observable:MobileAccount ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:MobileAccountFacet a owl:Class ;
	rdfs:label "MobileAccountFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1675 , _:c14n1752 , _:c14n1797 , _:c14n1834 , _:c14n2351 , _:c14n282 , _:c14n3221 , _:c14n53 , _:c14n798 ;
	skos:definition "A mobile account facet is a grouping of characteristics unique to an arrangement with an entity to enable and control the provision of some capability or service on a portable computing device. [based on https://www.lexico.com/definition/mobile_device]" ;
