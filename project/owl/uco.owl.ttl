	rdfs:range xsd:boolean ;
	skos:definition "UCO 1.5.0 declares the property uco-observable:isServiceAccount without a definition." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:isTLD a owl:DatatypeProperty ;
