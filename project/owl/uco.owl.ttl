	rdfs:label "issuerAlternativeName" ;
	rdfs:range xsd:string ;
	skos:definition "UCO 1.5.0 declares the property uco-observable:issuerAlternativeName without a definition." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
