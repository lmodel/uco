	skos:inScheme <https://w3id.org/lmodel/uco-location> .
uco_linkml:location a owl:ObjectProperty ;
	rdfs:label "location" ;
	rdfs:range uco_linkml:Location ;
	skos:definition "The locations where an action occurs." ;
	skos:inScheme <https://w3id.org/lmodel/uco-action> .
uco_linkml:loginTime a owl:DatatypeProperty ;
	rdfs:label "loginTime" ;
	rdfs:range xsd:dateTime ;
	skos:definition "Specifies the date/time of the login for the user session." ;
