	skos:definition "The access date and time recorded in an MFT entry $File_Name attribute." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:mftFileNameCreatedTime a owl:DatatypeProperty ;
	rdfs:label "mftFileNameCreatedTime" ;
