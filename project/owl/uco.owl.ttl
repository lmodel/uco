	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:metadataChangeTime a owl:DatatypeProperty ;
	rdfs:label "metadataChangeTime" ;
	rdfs:range xsd:dateTime ;
	skos:definition "The date and time at which the file metadata was last modified." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:metadataRecoveredStatus a owl:DatatypeProperty ;
	rdfs:label "metadataRecoveredStatus" ;
	rdfs:range _:c14n3564 ;
