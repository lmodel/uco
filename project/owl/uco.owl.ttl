	rdfs:label "itemDescription" ;
	rdfs:range xsd:string ;
	skos:definition "A description of a configuration setting entry item." ;
	skos:inScheme <https://w3id.org/lmodel/uco-configuration> .
uco_linkml:itemName a owl:DatatypeProperty ;
	rdfs:label "itemName" ;
	rdfs:range xsd:string ;
	skos:definition "The name of a configuration setting entry item." ;
	skos:inScheme <https://w3id.org/lmodel/uco-configuration> .
uco_linkml:itemObject a owl:ObjectProperty ;
	rdfs:label "itemObject" ;
	rdfs:range uco_linkml:UcoObject ;
	rdfs:seeAlso <https://github.com/ucoProject/UCO/issues/432> ;
