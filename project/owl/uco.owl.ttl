uco_linkml:messageID a owl:DatatypeProperty ;
	rdfs:label "messageID" ;
	rdfs:range xsd:string ;
	skos:definition "An unique identifier for the message." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:messageText a owl:DatatypeProperty ;
	rdfs:label "messageText" ;
	rdfs:range xsd:string ;
	skos:definition "The contents of the message." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:messageThread a owl:ObjectProperty ;
	rdfs:label "messageThread" ;
	rdfs:range uco_linkml:Thread ;
	skos:definition "UCO 1.5.0 declares the property uco-observable:messageThread without a definition." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:messageType a owl:DatatypeProperty ;
	rdfs:label "messageType" ;
	rdfs:range xsd:string ;
	rdfs:subPropertyOf uco_linkml:informalType ;
	skos:definition "Message type specifies what sort of message (email, chat, SMS, etc) a Message is." ;
