uco_linkml:isOptimized a owl:DatatypeProperty ;
	rdfs:label "isOptimized" ;
	rdfs:range xsd:boolean ;
	skos:definition "UCO 1.5.0 declares the property uco-observable:isOptimized without a definition." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:isPrivate a owl:DatatypeProperty ;
	rdfs:label "isPrivate" ;
	rdfs:range xsd:boolean ;
	skos:definition "Is the event marked as private?" ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:isPrivileged a owl:DatatypeProperty ;
	rdfs:label "isPrivileged" ;
	rdfs:range xsd:boolean ;
	skos:definition "UCO 1.5.0 declares the property uco-observable:isPrivileged without a definition." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:isProtected a owl:DatatypeProperty ;
	rdfs:label "isProtected" ;
	rdfs:range xsd:boolean ;
	skos:definition "The isProtected property specifies whether or not the particular memory object is protected (read/write only from the process that allocated it)." ;
