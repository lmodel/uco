	skos:definition "An environment variable is a grouping of characteristics unique to a dynamic-named value that can affect the way running processes will behave on a computer. [based on https://en.wikipedia.org/wiki/Environment_variable]" ;
	skos:exactMatch uco-observable:EnvironmentVariable ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
