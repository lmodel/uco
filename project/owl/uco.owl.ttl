uco_linkml:keyUsage a owl:DatatypeProperty ;
	rdfs:label "keyUsage" ;
	rdfs:range xsd:string ;
	skos:definition "UCO 1.5.0 declares the property uco-observable:keyUsage without a definition." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:keypadUnlockCode a owl:DatatypeProperty ;
	rdfs:label "keypadUnlockCode" ;
	rdfs:range xsd:string ;
	skos:definition "A code or password set on a device for security that must be entered to gain access to the device." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:keywordSearchTerm dcterms:title "Keyword Search Term" ;
	a owl:DatatypeProperty ;
	rdfs:label "keywordSearchTerm" ;
	rdfs:range xsd:string ;
	skos:definition "Specifies a string representing a keyword search term contained within the URL field." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:kindOfRelationship a owl:DatatypeProperty ;
	rdfs:label "kindOfRelationship" ;
	rdfs:range xsd:string ;
	skos:definition "A characterization of the nature of a relationship between objects." ;
	skos:inScheme <https://w3id.org/lmodel/uco-core> .
uco_linkml:labels a owl:DatatypeProperty ;
	rdfs:label "labels" ;
	rdfs:range xsd:string ;
	skos:definition "Named and colored label." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:language a owl:DatatypeProperty ;
	rdfs:label "language" ;
	rdfs:range xsd:string ;
	skos:definition "Specifies the language the string is written in, e.g. English. For consistency, it is strongly recommended to use the ISO 639-2 language code, if available. Please see http://www.loc.gov/standards/iso639-2/php/code_list.php for a list of ISO 639-2 codes." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:lastItem a owl:ObjectProperty ;
	rdfs:label "lastItem" ;
	rdfs:range uco_linkml:ListItem ;
	skos:definition "The last item of the list." ;
	skos:inScheme <https://w3id.org/lmodel/uco-co> .
uco_linkml:lastLoginTime a owl:DatatypeProperty ;
	rdfs:label "lastLoginTime" ;
	rdfs:range xsd:dateTime ;
	skos:definition "The date and time of the last login of the account." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:lastName a owl:DatatypeProperty ;
	rdfs:label "lastName" ;
	rdfs:range xsd:string ;
	skos:definition "The last name of a person." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:lastRun a owl:DatatypeProperty ;
	rdfs:label "lastRun" ;
	rdfs:range xsd:dateTime ;
	skos:definition "Timestamp of when the prefetch application was last run." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:lastShutdownDate a owl:DatatypeProperty ;
	rdfs:label "lastShutdownDate" ;
	rdfs:range xsd:dateTime ;
	skos:definition "Specifies the date on which the device was last shutdown." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:lastTimeContacted a owl:DatatypeProperty ;
	rdfs:label "lastTimeContacted" ;
	rdfs:range xsd:dateTime ;
	skos:definition "Last time contacted specifies the date and time that a particular contact was last contacted." ;
