	rdfs:label "length" ;
	rdfs:range xsd:integer ;
	skos:definition "Specifies the length, in characters, of the extracted string." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:libraries a owl:ObjectProperty ;
	rdfs:label "libraries" ;
	rdfs:range uco_linkml:LibraryType ;
	skos:definition "The libraries incorporated into a particular build of a software." ;
	skos:inScheme <https://w3id.org/lmodel/uco-tool> .
uco_linkml:libraryName a owl:DatatypeProperty ;
	rdfs:label "libraryName" ;
	rdfs:range xsd:string ;
	skos:definition "The name of the library." ;
	skos:inScheme <https://w3id.org/lmodel/uco-tool> .
