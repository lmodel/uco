	rdfs:subClassOf uco_linkml:Facet , _:c14n1013 , _:c14n1014 , _:c14n114 , _:c14n1469 , _:c14n1585 , _:c14n1792 , _:c14n2071 , _:c14n2179 , _:c14n2282 , _:c14n2416 , _:c14n2567 , _:c14n2704 , _:c14n2891 , _:c14n2957 , _:c14n2976 , _:c14n3188 , _:c14n3262 , _:c14n3302 , _:c14n3457 , _:c14n3511 , _:c14n3579 , _:c14n3621 , _:c14n3727 , _:c14n3746 , _:c14n67 , _:c14n709 , _:c14n733 , _:c14n960 ;
	skos:definition "A content data facet is a grouping of characteristics unique to a block of digital data." ;
	skos:exactMatch uco-observable:ContentDataFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:ContextualCompilation a owl:Class ;
	rdfs:label "ContextualCompilation" ;
	rdfs:subClassOf uco_linkml:Compilation , _:c14n118 , _:c14n476 ;
	skos:definition "A contextual compilation is a grouping of things sharing some context (e.g., a set of network connections observed on a given day, all accounts associated with a given person)." ;
	skos:exactMatch uco-core:ContextualCompilation ;
	skos:inScheme <https://w3id.org/lmodel/uco-core> .
uco_linkml:ControlledDictionary a owl:Class ;
	rdfs:label "ControlledDictionary" ;
	rdfs:subClassOf uco_linkml:Dictionary , _:c14n2607 , _:c14n2870 ;
	skos:definition "A controlled dictionary is a list of (term/key, value) pairs where each term/key exists no more than once and is constrained to an explicitly defined set of values." ;
	skos:exactMatch uco-types:ControlledDictionary ;
	skos:inScheme <https://w3id.org/lmodel/uco-types> .
uco_linkml:ControlledDictionaryEntry a owl:Class ;
	rdfs:label "ControlledDictionaryEntry" ;
	rdfs:subClassOf uco_linkml:DictionaryEntry ;
	skos:definition "A controlled dictionary entry is a single (term/key, value) pair where the term/key is constrained to an explicitly defined set of values." ;
	skos:exactMatch uco-types:ControlledDictionaryEntry ;
	skos:inScheme <https://w3id.org/lmodel/uco-types> .
uco_linkml:ControlledVocabulary a owl:Class ;
	rdfs:label "ControlledVocabulary" ;
	rdfs:subClassOf uco_linkml:UcoObject , _:c14n1739 , _:c14n2318 , _:c14n254 , _:c14n2661 , _:c14n3506 , _:c14n3688 , _:c14n371 , _:c14n3814 , _:c14n3892 ;
	skos:definition "A controlled vocabulary is an explicitly constrained set of string values." ;
	skos:exactMatch uco-core:ControlledVocabulary ;
	skos:inScheme <https://w3id.org/lmodel/uco-core> .
uco_linkml:CookieHistory a owl:Class ;
	rdfs:label "CookieHistory" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A cookie history is the stored web cookie history for a particular web browser." ;
	skos:exactMatch uco-observable:CookieHistory ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:CountryOfResidenceFacet a owl:Class ;
	rdfs:label "CountryOfResidenceFacet" ;
	rdfs:subClassOf uco_linkml:IdentityFacet ;
	skos:definition "Country of residence is a grouping of characteristics unique to information related to the country, or countries, where an entity resides." ;
	skos:exactMatch uco-identity:CountryOfResidenceFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-identity> .
uco_linkml:Credential a owl:Class ;
	rdfs:label "Credential" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A credential is a single specific login and password combination for authorization of access to a digital account or system." ;
	skos:exactMatch uco-observable:Credential ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:CredentialDump a owl:Class ;
	rdfs:label "CredentialDump" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A credential dump is a collection (typically forcibly extracted from a system) of specific login and password combinations for authorization of access to a digital account or system." ;
	skos:exactMatch uco-observable:CredentialDump ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:DNSCache a owl:Class ;
	rdfs:label "DNSCache" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "An DNS cache is a temporary locally stored collection of previous Domain Name System (DNS) query results (created when an domain name is resolved to a IP address) for a particular computer." ;
	skos:exactMatch uco-observable:DNSCache ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:DNSRecord a owl:Class ;
	rdfs:label "DNSRecord" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A DNS record is a single Domain Name System (DNS) artifact specifying information of a particular type (routing, authority, responsibility, security, etc.) for a specific Internet domain name." ;
	skos:exactMatch uco-observable:DNSRecord ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:DataRangeFacet a owl:Class ;
	rdfs:label "DataRangeFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1717 , _:c14n1782 , _:c14n2241 , _:c14n2563 , _:c14n2564 , _:c14n3377 , _:c14n3650 , _:c14n686 , _:c14n983 ;
	skos:definition "A data range facet is a grouping of characteristics unique to a particular contiguous scope within a block of digital data." ;
	skos:exactMatch uco-observable:DataRangeFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:DefensiveTool a owl:Class ;
	rdfs:label "DefensiveTool" ;
	rdfs:subClassOf uco_linkml:Tool ;
	skos:definition "A defensive tool is an artifact of hardware and/or software utilized to accomplish a task or purpose of guarding." ;
	skos:exactMatch uco-tool:DefensiveTool ;
	skos:inScheme <https://w3id.org/lmodel/uco-tool> .
uco_linkml:DefinedEffectFacet a owl:Class ;
	rdfs:label "DefinedEffectFacet" ;
	rdfs:subClassOf uco_linkml:Facet ;
	skos:definition "A defined effect facet is a grouping of characteristics unique to the effect of an observable action in relation to one or more observable objects." ;
	skos:exactMatch uco-observable:DefinedEffectFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:Dependency a owl:Class ;
	rdfs:label "Dependency" ;
	rdfs:subClassOf uco_linkml:UcoInherentCharacterizationThing , _:c14n1026 , _:c14n176 , _:c14n250 , _:c14n2522 , _:c14n790 , _:c14n974 ;
	skos:definition "A dependency is a grouping of characteristics unique to something that a tool or other software relies on to function as intended." ;
	skos:exactMatch uco-configuration:Dependency ;
	skos:inScheme <https://w3id.org/lmodel/uco-configuration> .
uco_linkml:Device a owl:Class ;
	rdfs:label "Device" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A device is a piece of equipment or a mechanism designed to serve a special purpose or perform a special function. [based on https://www.merriam-webster.com/dictionary/device]" ;
	skos:exactMatch uco-observable:Device ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:DeviceFacet a owl:Class ;
	rdfs:label "DeviceFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n115 , _:c14n1322 , _:c14n1450 , _:c14n1650 , _:c14n226 , _:c14n2382 , _:c14n2901 , _:c14n3023 , _:c14n3051 , _:c14n3458 , _:c14n3493 , _:c14n3747 , _:c14n3829 , _:c14n903 , _:c14n910 ;
	skos:definition "A device facet is a grouping of characteristics unique to a piece of equipment or a mechanism designed to serve a special purpose or perform a special function. [based on https://www.merriam-webster.com/dictionary/device]" ;
	skos:exactMatch uco-observable:DeviceFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:Dictionary a owl:Class ;
	rdfs:label "Dictionary" ;
	rdfs:subClassOf uco_linkml:UcoInherentCharacterizationThing , _:c14n1032 , _:c14n2425 ;
	skos:definition "A dictionary is list of (term/key, value) pairs with each term/key having an expectation to exist no more than once. types:Dictionary alone does not validate this expectation, but validation is available. For use cases where this expectation must be validated, the subclass types:ProperDictionary should be used instead of types:Dictionary. For instances where this expectation has been found to be violated, the subclass types:ImproperDictionary should be used instead of types:Dictionary." ;
	skos:exactMatch uco-types:Dictionary ;
	skos:inScheme <https://w3id.org/lmodel/uco-core> .
uco_linkml:DictionaryEntry a owl:Class ;
	rdfs:label "DictionaryEntry" ;
	rdfs:subClassOf uco_linkml:UcoInherentCharacterizationThing , _:c14n1030 , _:c14n1393 , _:c14n1715 , _:c14n1726 , _:c14n2187 , _:c14n3913 ;
	skos:definition "A dictionary entry is a single (term/key, value) pair." ;
	skos:exactMatch uco-types:DictionaryEntry ;
	skos:inScheme <https://w3id.org/lmodel/uco-core> .
uco_linkml:DigitalAccount a owl:Class ;
	rdfs:label "DigitalAccount" ;
	rdfs:subClassOf uco_linkml:Account ;
	skos:definition "A digital account is an arrangement with an entity to enable and control the provision of some capability or service within the digital domain." ;
	skos:exactMatch uco-observable:DigitalAccount ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:DigitalAccountFacet a owl:Class ;
	rdfs:label "DigitalAccountFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1083 , _:c14n1166 , _:c14n1247 , _:c14n1695 , _:c14n1904 , _:c14n240 , _:c14n2785 , _:c14n3017 , _:c14n317 , _:c14n3213 , _:c14n3487 , _:c14n3869 , _:c14n407 , _:c14n994 ;
	skos:definition "A digital account facet is a grouping of characteristics unique to an arrangement with an entity to enable and control the provision of some capability or service within the digital domain." ;
	skos:exactMatch uco-observable:DigitalAccountFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:DigitalAddress a owl:Class ;
	rdfs:label "DigitalAddress" ;
	rdfs:subClassOf uco_linkml:Address ;
	skos:definition "A digital address is an identifier assigned to enable routing and management of digital communication." ;
	skos:exactMatch uco-observable:DigitalAddress ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:DigitalAddressFacet a owl:Class ;
	rdfs:label "DigitalAddressFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n2665 , _:c14n2792 , _:c14n374 , _:c14n519 , _:c14n626 , _:c14n8 ;
	skos:definition "A digital address facet is a grouping of characteristics unique to an identifier assigned to enable routing and management of digital communication." ;
	skos:exactMatch uco-observable:DigitalAddressFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:DigitalCamera a owl:Class ;
	rdfs:label "DigitalCamera" ;
	rdfs:subClassOf uco_linkml:Device ;
	skos:definition "A digital camera is a camera that captures photographs in digital memory as opposed to capturing images on photographic film." ;
	skos:exactMatch uco-observable:DigitalCamera ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:DigitalSignatureInfo a owl:Class ;
	rdfs:label "DigitalSignatureInfo" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A digital signature info is a value calculated via a mathematical scheme for demonstrating the authenticity of an electronic message or document." ;
	skos:exactMatch uco-observable:DigitalSignatureInfo ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:DigitalSignatureInfoFacet a owl:Class ;
	rdfs:label "DigitalSignatureInfoFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1372 , _:c14n1677 , _:c14n1847 , _:c14n1956 , _:c14n1962 , _:c14n2017 , _:c14n2113 , _:c14n2455 , _:c14n2762 , _:c14n2967 , _:c14n3357 , _:c14n3383 , _:c14n3808 , _:c14n427 , _:c14n743 ;
	skos:definition "A digital signature info facet is a grouping of characteristics unique to a value calculated via a mathematical scheme for demonstrating the authenticity of an electronic message or document." ;
	skos:exactMatch uco-observable:DigitalSignatureInfoFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:Directory a owl:Class ;
	rdfs:label "Directory" ;
	rdfs:subClassOf uco_linkml:FileSystemObject ;
	skos:definition "A directory is a file system cataloging structure which contains references to other computer files, and possibly other directories. On many computers, directories are known as folders, or drawers, analogous to a workbench or the traditional office filing cabinet. In UNIX a directory is implemented as a special file. [based on https://en.wikipedia.org/wiki/Directory_(computing)]" ;
	skos:exactMatch uco-observable:Directory ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:Disk a owl:Class ;
	rdfs:label "Disk" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A disk is a storage mechanism where data is recorded by various electronic, magnetic, optical, or mechanical changes to a surface layer of one or more rotating disks." ;
	skos:exactMatch uco-observable:Disk ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:DiskFacet a owl:Class ;
	rdfs:label "DiskFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1264 , _:c14n1323 , _:c14n170 , _:c14n1703 , _:c14n178 , _:c14n2049 , _:c14n2886 , _:c14n3349 , _:c14n3501 , _:c14n3533 , _:c14n801 ;
	skos:definition "A disk facet is a grouping of characteristics unique to a storage mechanism where data is recorded by various electronic, magnetic, optical, or mechanical changes to a surface layer of one or more rotating disks." ;
	skos:exactMatch uco-observable:DiskFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:DiskPartition a owl:Class ;
	rdfs:label "DiskPartition" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A disk partition is a particular managed region on a storage mechanism where data is recorded by various electronic, magnetic, optical, or mechanical changes to a surface layer of one or more rotating disks. [based on https://en.wikipedia.org/wiki/Disk_storage]" ;
	skos:exactMatch uco-observable:DiskPartition ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:DiskPartitionFacet a owl:Class ;
	rdfs:label "DiskPartitionFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1335 , _:c14n1358 , _:c14n143 , _:c14n1475 , _:c14n1551 , _:c14n1663 , _:c14n1744 , _:c14n1924 , _:c14n1957 , _:c14n1965 , _:c14n2096 , _:c14n2104 , _:c14n2218 , _:c14n2486 , _:c14n2639 , _:c14n2918 , _:c14n3036 , _:c14n3181 , _:c14n380 , _:c14n535 , _:c14n609 , _:c14n679 , _:c14n755 , _:c14n876 , _:c14n909 , _:c14n916 , _:c14n941 ;
	skos:definition "A disk partition facet is a grouping of characteristics unique to a particular managed region on a storage mechanism." ;
	skos:exactMatch uco-observable:DiskPartitionFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:DomainName a owl:Class ;
	rdfs:label "DomainName" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A domain name is an identification string that defines a realm of administrative autonomy, authority or control within the Internet. [based on https://en.wikipedia.org/wiki/Domain_name]" ;
	skos:exactMatch uco-observable:DomainName ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:DomainNameFacet a owl:Class ;
	rdfs:label "DomainNameFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1410 , _:c14n163 , _:c14n1866 , _:c14n3229 , _:c14n3254 , _:c14n928 ;
	skos:definition "A domain name facet is a grouping of characteristics unique to an identification string that defines a realm of administrative autonomy, authority or control within the Internet. [based on https://en.wikipedia.org/wiki/Domain_name]" ;
	skos:exactMatch uco-observable:DomainNameFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:Drone a owl:Class ;
	rdfs:label "Drone" ;
	rdfs:subClassOf uco_linkml:MobileDevice ;
	skos:definition "A drone, unmanned aerial vehicle (UAV), is an aircraft without a human pilot, crew, or passengers that typically involve a ground-based controller and a system for communications with the UAV." ;
	skos:exactMatch uco-observable:Drone ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:ESN a owl:DatatypeProperty ;
	rdfs:label "ESN" ;
	rdfs:range xsd:string ;
	skos:definition "Electronic Serial Number ." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:EXIFFacet a owl:Class ;
	rdfs:label "EXIFFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n2233 , _:c14n446 ;
	skos:definition "An EXIF (exchangeable image file format) facet is a grouping of characteristics unique to the formats for images, sound, and ancillary tags used by digital cameras (including smartphones), scanners and other systems handling image and sound files recorded by digital cameras conformant to JEIDA/JEITA/CIPA specifications. [based on https://en.wikipedia.org/wiki/Exif]" ;
	skos:exactMatch uco-observable:EXIFFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:EmailAccount a owl:Class ;
	rdfs:label "EmailAccount" ;
	rdfs:subClassOf uco_linkml:DigitalAccount ;
	skos:definition "An email account is an arrangement with an entity to enable and control the provision of electronic mail (email) capabilities or services." ;
	skos:exactMatch uco-observable:EmailAccount ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:EmailAccountFacet a owl:Class ;
	rdfs:label "EmailAccountFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1918 , _:c14n2534 , _:c14n3902 ;
	skos:definition "An email account facet is a grouping of characteristics unique to an arrangement with an entity to enable and control the provision of electronic mail (email) capabilities or services." ;
	skos:exactMatch uco-observable:EmailAccountFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:EmailAddress a owl:Class ;
	rdfs:label "EmailAddress" ;
	rdfs:subClassOf uco_linkml:DigitalAddress ;
	skos:definition "An email address is an identifier for an electronic mailbox to which electronic mail messages (conformant to the Simple Mail Transfer Protocol (SMTP)) are sent from and delivered to." ;
	skos:exactMatch uco-observable:EmailAddress ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:EmailAddressFacet a owl:Class ;
	rdfs:label "EmailAddressFacet" ;
	rdfs:subClassOf uco_linkml:DigitalAddressFacet ;
	skos:definition "An email address facet is a grouping of characteristics unique to an identifier for an electronic mailbox to which electronic mail messages (conformant to the Simple Mail Transfer Protocol (SMTP)) are sent from and delivered to." ;
	skos:exactMatch uco-observable:EmailAddressFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:EmailMessage a owl:Class ;
	rdfs:label "EmailMessage" ;
	rdfs:subClassOf uco_linkml:Message ;
	skos:definition "An email message is a message that is an instance of an electronic mail correspondence conformant to the internet message format described in RFC 5322 and related RFCs." ;
	skos:exactMatch uco-observable:EmailMessage ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:EmailMessageFacet a owl:Class ;
	rdfs:label "EmailMessageFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1023 , _:c14n1043 , _:c14n1103 , _:c14n1109 , _:c14n1127 , _:c14n1149 , _:c14n1193 , _:c14n1210 , _:c14n1218 , _:c14n1297 , _:c14n1306 , _:c14n1318 , _:c14n1360 , _:c14n1413 , _:c14n1434 , _:c14n1437 , _:c14n1457 , _:c14n1459 , _:c14n1499 , _:c14n1600 , _:c14n1634 , _:c14n1652 , _:c14n1884 , _:c14n1916 , _:c14n2008 , _:c14n208 , _:c14n2100 , _:c14n2102 , _:c14n216 , _:c14n2206 , _:c14n2258 , _:c14n2350 , _:c14n2380 , _:c14n2381 , _:c14n2463 , _:c14n2496 , _:c14n2515 , _:c14n2536 , _:c14n2538 , _:c14n2658 , _:c14n2692 , _:c14n270 , _:c14n2724 , _:c14n2778 , _:c14n2782 , _:c14n290 , _:c14n2904 , _:c14n2983 , _:c14n3007 , _:c14n3039 , _:c14n3172 , _:c14n3194 , _:c14n3328 , _:c14n3369 , _:c14n3371 , _:c14n338 , _:c14n3397 , _:c14n3436 , _:c14n3453 , _:c14n35 , _:c14n3541 , _:c14n3674 , _:c14n3702 , _:c14n3750 , _:c14n3767 , _:c14n3799 , _:c14n3856 , _:c14n465 , _:c14n510 , _:c14n515 , _:c14n538 , _:c14n625 , _:c14n634 , _:c14n680 , _:c14n693 , _:c14n75 , _:c14n792 , _:c14n878 , _:c14n952 ;
	skos:definition "An email message facet is a grouping of characteristics unique to a message that is an instance of an electronic mail correspondence conformant to the internet message format described in RFC 5322 and related RFCs." ;
	skos:exactMatch uco-observable:EmailMessageFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:EmbeddedDevice a owl:Class ;
	rdfs:label "EmbeddedDevice" ;
	rdfs:subClassOf uco_linkml:Device ;
	skos:definition "An embedded device is a highly specialized microprocessor device meant for one or very few specific purposes and is usually embedded or included within another object or as part of a larger system. Examples include answer machine, door access logger, card scanner, etc." ;
	skos:exactMatch uco-observable:EmbeddedDevice ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:EnclosingCompilation a owl:Class ;
	rdfs:label "EnclosingCompilation" ;
	rdfs:subClassOf uco_linkml:Compilation , _:c14n1720 , _:c14n2237 ;
	skos:definition "An enclosing compilation is a container for a grouping of things." ;
	skos:exactMatch uco-core:EnclosingCompilation ;
	skos:inScheme <https://w3id.org/lmodel/uco-core> .
uco_linkml:EncodedStreamFacet a owl:Class ;
	rdfs:label "EncodedStreamFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1069 , _:c14n1329 , _:c14n1747 ;
	skos:definition "An encoded stream facet is a grouping of characteristics unique to the conversion of a body of data content from one form to another form." ;
	skos:exactMatch uco-observable:EncodedStreamFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:EncryptedStreamFacet a owl:Class ;
	rdfs:label "EncryptedStreamFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1122 , _:c14n1292 , _:c14n1692 , _:c14n221 , _:c14n232 , _:c14n2895 , _:c14n2938 , _:c14n3373 , _:c14n3560 , _:c14n529 ;
	skos:definition "An encrypted stream facet is a grouping of characteristics unique to the conversion of a body of data content from one form to another obfuscated form in such a way that reversing the conversion to obtain the original data form can only be accomplished through possession and use of a specific key." ;
	skos:exactMatch uco-observable:EncryptedStreamFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
