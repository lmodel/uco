	skos:exactMatch uco-core:ModusOperandi ;
	skos:inScheme <https://w3id.org/lmodel/uco-core> .
uco_linkml:Mutex a owl:Class ;
	rdfs:label "Mutex" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A mutex is a mechanism that enforces limits on access to a resource when there are many threads of execution. A mutex is designed to enforce a mutual exclusion concurrency control policy, and with a variety of possible methods there exists multiple unique implementations for different applications. [based on https://en.wikipedia.org/wiki/Lock_(computer_science)]" ;
	skos:exactMatch uco-observable:Mutex ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
