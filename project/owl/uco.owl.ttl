	rdfs:subClassOf uco_linkml:NetworkConnection ;
	skos:definition "A wireless network connection is a connection (completed or attempted) across an IEEE 802.11 standards-confromant digital network (a group of two or more computer systems linked together). [based on https://www.webopedia.com/TERM/N/network.html]" ;
	skos:exactMatch uco-observable:WirelessNetworkConnection ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
