uco_linkml:libraryVersion a owl:DatatypeProperty ;
	rdfs:label "libraryVersion" ;
	rdfs:range xsd:string ;
	skos:definition "The version of the library." ;
	skos:inScheme <https://w3id.org/lmodel/uco-tool> .
