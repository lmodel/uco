	rdfs:subClassOf uco_linkml:Facet , _:c14n1628 , _:c14n3622 ;
	skos:definition "An extracted strings facet is a grouping of characteristics unique to one or more sequences of characters pulled from an observable object." ;
	skos:exactMatch uco-observable:ExtractedStringsFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:Facet a owl:Class ;
