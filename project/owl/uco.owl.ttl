uco_linkml:pdfCreationDate a owl:DatatypeProperty ;
	rdfs:label "pdfCreationDate" ;
	rdfs:range xsd:dateTime ;
	skos:definition "The PDF CreationDate property is defined in ISO 32000-1:2008 as 'The date and time the document was created, in human-readable form' (Table 317). As a UCO property, its value is converted to xsd:dateTime." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:pdfId0 a owl:DatatypeProperty ;
	rdfs:label "pdfId0" ;
	rdfs:range xsd:string ;
	skos:definition "UCO 1.5.0 declares the property uco-observable:pdfId0 without a definition." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:pdfId1 a owl:DatatypeProperty ;
	rdfs:label "pdfId1" ;
	rdfs:range xsd:string ;
	skos:definition "UCO 1.5.0 declares the property uco-observable:pdfId1 without a definition." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:pdfModDate a owl:DatatypeProperty ;
	rdfs:label "pdfModDate" ;
	rdfs:range xsd:dateTime ;
	skos:definition "The PDF ModDate property is defined in ISO 32000-1:2008 as 'The date and time the document was most recently modified, in human-readable form' (Table 317). As a UCO property, its value is converted to xsd:dateTime." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:pdop a owl:DatatypeProperty ;
