uco_linkml:itemType a owl:DatatypeProperty ;
	rdfs:label "itemType" ;
	rdfs:range xsd:string ;
	rdfs:subPropertyOf uco_linkml:informalType ;
	skos:definition "The type of a configuration setting entry item." ;
	skos:inScheme <https://w3id.org/lmodel/uco-configuration> .
uco_linkml:itemValue a owl:DatatypeProperty ;
	rdfs:label "itemValue" ;
	rdfs:range xsd:string ;
	skos:definition "The value of a configuration setting entry instance." ;
	skos:inScheme <https://w3id.org/lmodel/uco-configuration> .
uco_linkml:key a owl:DatatypeProperty ;
	rdfs:label "key" ;
	rdfs:range xsd:string ;
	skos:definition "A key property of a single dictionary entry." ;
