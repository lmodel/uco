	rdfs:label "issuerHash" ;
	rdfs:range uco_linkml:Hash ;
	skos:definition "A hash calculated on the certificate issuer name." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:item a owl:DatatypeProperty ;
	rdfs:label "item" ;
	skos:definition "An item of the collection." ;
	skos:inScheme <https://w3id.org/lmodel/uco-co> .
uco_linkml:itemContent a owl:DatatypeProperty ;
	rdfs:label "itemContent" ;
	rdfs:range xsd:anyURI ;
	skos:definition "The element that the item wraps." ;
