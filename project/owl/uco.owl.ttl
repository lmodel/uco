	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:mimeClass a owl:DatatypeProperty ;
	rdfs:label "mimeClass" ;
	rdfs:range xsd:string ;
	skos:definition "UCO 1.5.0 declares the property uco-observable:mimeClass without a definition." ;
