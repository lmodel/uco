	rdfs:subClassOf uco_linkml:Identity ;
	skos:definition "An organization is a grouping of identifying characteristics unique to a group of people who work together in an organized way for a shared purpose. [based on https://dictionary.cambridge.org/us/dictionary/english/organization]" ;
	skos:exactMatch uco-identity:Organization ;
	skos:inScheme <https://w3id.org/lmodel/uco-identity> .
uco_linkml:OrganizationDetailsFacet a owl:Class ;
