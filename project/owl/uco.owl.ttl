	skos:exactMatch uco-observable:PhoneAccountFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:PhysicalInfoFacet a owl:Class ;
	rdfs:label "PhysicalInfoFacet" ;
	rdfs:subClassOf uco_linkml:IdentityFacet ;
	skos:definition "Physical info is a grouping of characteristics unique to the outwardly observable nature of an individual person." ;
	skos:exactMatch uco-identity:PhysicalInfoFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-identity> .
uco_linkml:Pipe a owl:Class ;
	rdfs:label "Pipe" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A pipe is a mechanism for one-way inter-process communication using message passing where data written by one process is buffered by the operating system until it is read by the next process, and this uni-directional channel disappears when the processes are completed. [based on https://en.wikipedia.org/wiki/Pipeline_(Unix) ; https://en.wikipedia.org/wiki/Anonymous_pipe]" ;
	skos:exactMatch uco-observable:Pipe ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:Post a owl:Class ;
	rdfs:label "Post" ;
	rdfs:subClassOf uco_linkml:Message ;
	skos:definition "A post is message submitted to an online discussion/publishing site (forum, blog, etc.)." ;
	skos:exactMatch uco-observable:Post ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:Process a owl:Class ;
	rdfs:label "Process" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A process is an instance of a computer program executed on an operating system." ;
	skos:exactMatch uco-observable:Process ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:ProcessFacet a owl:Class ;
	rdfs:label "ProcessFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1034 , _:c14n1274 , _:c14n1314 , _:c14n1395 , _:c14n1420 , _:c14n1438 , _:c14n1523 , _:c14n1674 , _:c14n1816 , _:c14n1821 , _:c14n1901 , _:c14n2032 , _:c14n2070 , _:c14n2234 , _:c14n2316 , _:c14n2366 , _:c14n2700 , _:c14n2909 , _:c14n3001 , _:c14n319 , _:c14n3196 , _:c14n3218 , _:c14n3335 , _:c14n3414 , _:c14n3432 , _:c14n3438 , _:c14n353 , _:c14n3685 , _:c14n3831 , _:c14n393 , _:c14n425 , _:c14n558 , _:c14n580 , _:c14n927 , _:c14n947 ;
	skos:definition "A process facet is a grouping of characteristics unique to an instance of a computer program executed on an operating system." ;
	skos:exactMatch uco-observable:ProcessFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:ProcessThread a owl:Class ;
	rdfs:label "ProcessThread" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A process thread is the smallest sequence of programmed instructions that can be managed independently by a scheduler on a computer, which is typically a part of the operating system. It is a component of a process. Multiple threads can exist within one process, executing concurrently and sharing resources such as memory, while different processes do not share these resources. In particular, the threads of a process share its executable code and the values of its dynamically allocated variables and non-thread-local global variables at any given time. [based on https://en.wikipedia.org/wiki/Thread_(computing)]" ;
	skos:exactMatch uco-observable:ProcessThread ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:Profile a owl:Class ;
	rdfs:label "Profile" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A profile is an explicit digital representation of identity and characteristics of the owner of a single user account associated with an online service or application. [based on https://en.wikipedia.org/wiki/User_profile]" ;
	skos:exactMatch uco-observable:Profile ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:ProfileFacet a owl:Class ;
	rdfs:label "ProfileFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1052 , _:c14n1180 , _:c14n1202 , _:c14n1300 , _:c14n1533 , _:c14n1684 , _:c14n1794 , _:c14n2062 , _:c14n2242 , _:c14n2256 , _:c14n2402 , _:c14n2420 , _:c14n2553 , _:c14n2698 , _:c14n3010 , _:c14n3130 , _:c14n3150 , _:c14n3228 , _:c14n3275 , _:c14n3399 , _:c14n3402 , _:c14n3582 , _:c14n3709 , _:c14n377 , _:c14n3821 , _:c14n3861 , _:c14n3885 , _:c14n467 , _:c14n479 , _:c14n511 , _:c14n549 , _:c14n630 , _:c14n655 , _:c14n701 , _:c14n759 , _:c14n841 , _:c14n905 , _:c14n937 ;
	skos:definition "A profile facet is a grouping of characteristics unique to an explicit digital representation of identity and characteristics of the owner of a single user account associated with an online service or application. [based on https://en.wikipedia.org/wiki/User_profile]" ;
	skos:exactMatch uco-observable:ProfileFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:ProperDictionary a owl:Class ;
	rdfs:label "ProperDictionary" ;
	rdfs:subClassOf uco_linkml:Dictionary ;
	skos:definition "A proper dictionary is list of (term/key, value) pairs with each term/key existing no more than once." ;
	skos:exactMatch uco-types:ProperDictionary ;
	skos:inScheme <https://w3id.org/lmodel/uco-types> .
uco_linkml:PropertiesEnumeratedEffectFacet a owl:Class ;
	rdfs:label "PropertiesEnumeratedEffectFacet" ;
	rdfs:subClassOf uco_linkml:DefinedEffectFacet , _:c14n1950 , _:c14n2518 , _:c14n3645 ;
	skos:definition "A properties enumerated effect facet is a grouping of characteristics unique to the effects of actions upon observable objects where a characteristic of the observable object is enumerated. An example of this would be startup parameters for a process." ;
	skos:exactMatch uco-observable:PropertiesEnumeratedEffectFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:PropertyReadEffectFacet a owl:Class ;
	rdfs:label "PropertyReadEffectFacet" ;
	rdfs:subClassOf uco_linkml:DefinedEffectFacet , _:c14n1859 , _:c14n2108 , _:c14n2875 , _:c14n3391 , _:c14n3845 , _:c14n992 ;
	skos:definition "A properties read effect facet is a grouping of characteristics unique to the effects of actions upon observable objects where a characteristic is read from an observable object. An example of this would be the current running state of a process." ;
	skos:exactMatch uco-observable:PropertyReadEffectFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:ProtocolConverter a owl:Class ;
	rdfs:label "ProtocolConverter" ;
	rdfs:subClassOf uco_linkml:Device ;
	skos:definition "A protocol converter is a device that converts from one protocol to another (e.g. SD to USB, SATA to USB, etc." ;
	skos:exactMatch uco-observable:ProtocolConverter ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:QualificationFacet a owl:Class ;
	rdfs:label "QualificationFacet" ;
	rdfs:subClassOf uco_linkml:IdentityFacet ;
	skos:definition "Qualification is a grouping of characteristics unique to particular skills, capabilities or their related achievements (educational, professional, etc.) of an entity." ;
	skos:exactMatch uco-identity:QualificationFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-identity> .
uco_linkml:RasterPicture a owl:Class ;
	rdfs:label "RasterPicture" ;
	rdfs:subClassOf uco_linkml:File ;
	skos:definition "A raster picture is a raster (or bitmap) image." ;
	skos:exactMatch uco-observable:RasterPicture ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:RasterPictureFacet a owl:Class ;
	rdfs:label "RasterPictureFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1864 , _:c14n1893 , _:c14n2117 , _:c14n2379 , _:c14n261 , _:c14n2720 , _:c14n2868 , _:c14n2869 , _:c14n2919 , _:c14n2969 , _:c14n3053 , _:c14n3366 , _:c14n3434 , _:c14n3636 , _:c14n3648 , _:c14n664 , _:c14n719 , _:c14n781 ;
	skos:definition "A raster picture facet is a grouping of characteristics unique to a raster (or bitmap) image." ;
	skos:exactMatch uco-observable:RasterPictureFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:RecoveredObject a owl:Class ;
	rdfs:label "RecoveredObject" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "An observable object that was the result of a recovery operation." ;
	skos:exactMatch uco-observable:RecoveredObject ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:RecoveredObjectFacet a owl:Class ;
	rdfs:label "RecoveredObjectFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1424 , _:c14n1610 , _:c14n2061 , _:c14n3192 , _:c14n3311 , _:c14n37 , _:c14n3763 , _:c14n484 , _:c14n794 ;
	skos:definition "Recoverability status of name, metadata, and content." ;
	skos:exactMatch uco-observable:RecoveredObjectFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:RelatedIdentityFacet a owl:Class ;
	rdfs:label "RelatedIdentityFacet" ;
	rdfs:subClassOf uco_linkml:IdentityFacet ;
	skos:definition "<Needs fleshed out from CIQ>" ;
	skos:exactMatch uco-identity:RelatedIdentityFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-identity> .
uco_linkml:Relationship a owl:Class ;
	rdfs:label "Relationship" ;
	rdfs:subClassOf uco_linkml:UcoObject , _:c14n1334 , _:c14n1351 , _:c14n1520 , _:c14n1563 , _:c14n1931 , _:c14n2340 , _:c14n2761 , _:c14n2885 , _:c14n2906 , _:c14n3332 , _:c14n3620 , _:c14n3735 , _:c14n3846 , _:c14n475 , _:c14n520 ;
	skos:definition "A relationship is a grouping of characteristics unique to an assertion that one or more objects are related to another object in some way." ;
	skos:exactMatch uco-core:Relationship ;
	skos:inScheme <https://w3id.org/lmodel/uco-core> .
uco_linkml:ReleaseToMarking dcterms:title "Release-To Marking" ;
	a owl:Class ;
	rdfs:label "ReleaseToMarking" ;
	rdfs:subClassOf uco_linkml:MarkingModel , _:c14n134 , _:c14n1798 , _:c14n1930 , _:c14n2401 , _:c14n3327 ;
	skos:definition "A release-to marking is a grouping of characteristics unique to the expression of data marking definitions (restrictions, permissions, and other guidance for how data can be used and shared) to convey details of authorized persons and/or organizations to which to the associated content may be released. The existence of the Release-To marking restricts access to ONLY those identities explicitly listed, regardless of whether another data marking exists that allows sharing with other members of the community." ;
	skos:exactMatch uco-marking:ReleaseToMarking ;
	skos:inScheme <https://w3id.org/lmodel/uco-marking> .
uco_linkml:ReparsePoint a owl:Class ;
	rdfs:label "ReparsePoint" ;
	rdfs:subClassOf uco_linkml:FileSystemObject ;
	skos:definition "A reparse point is a type of NTFS (New Technology File System) object which is an optional attribute of files and directories meant to define some sort of preprocessing before accessing the said file or directory. For instance reparse points can be used to redirect access to files which have been moved to long term storage so that some application would retrieve them and make them directly accessible. A reparse point contains a reparse tag and data that are interpreted by a filesystem filter identified by the tag. [based on https://jp-andre.pagesperso-orange.fr/junctions.html ; https://en.wikipedia.org/wiki/NTFS_reparse_point]" ;
	skos:exactMatch uco-observable:ReparsePoint ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:Role a owl:Class ;
	rdfs:label "Role" ;
	rdfs:subClassOf uco_linkml:UcoObject ;
	skos:definition "A role is a usual or customary function based on contextual perspective." ;
	skos:exactMatch uco-role:Role ;
	skos:inScheme <https://w3id.org/lmodel/uco-role> .
uco_linkml:SIMCard a owl:Class ;
	rdfs:label "SIMCard" ;
	rdfs:subClassOf uco_linkml:Device ;
	skos:definition "A SIM card is a subscriber identification module card intended to securely store the international mobile subscriber identity (IMSI) number and its related key, which are used to identify and authenticate subscribers on mobile telephony. [based on https://en.wikipedia.org/wiki/SIM_card]" ;
	skos:exactMatch uco-observable:SIMCard ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:SIMCardFacet a owl:Class ;
	rdfs:label "SIMCardFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1403 , _:c14n1484 , _:c14n1886 , _:c14n1896 , _:c14n197 , _:c14n2035 , _:c14n2069 , _:c14n2151 , _:c14n2165 , _:c14n2555 , _:c14n2572 , _:c14n2655 , _:c14n2735 , _:c14n2894 , _:c14n3182 , _:c14n3405 , _:c14n3510 , _:c14n3627 , _:c14n3737 , _:c14n432 , _:c14n56 , _:c14n832 , _:c14n95 , _:c14n959 ;
	skos:definition "A SIM card facet is a grouping of characteristics unique to a subscriber identification module card intended to securely store the international mobile subscriber identity (IMSI) number and its related key, which are used to identify and authenticate subscribers on mobile telephony devices (such as mobile phones and computers). [based on https://en.wikipedia.org/wiki/SIM_card]" ;
	skos:exactMatch uco-observable:SIMCardFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:SIMForm a owl:DatatypeProperty ;
	rdfs:label "SIMForm" ;
	rdfs:range xsd:string ;
	skos:definition "The form of SIM card such as SIM, Micro SIM, Nano SIM." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:SIMType a owl:DatatypeProperty ;
	rdfs:label "SIMType" ;
	rdfs:range xsd:string ;
	skos:definition "The type of SIM card such as SIM, USIM, UICC." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:SIPAddress a owl:Class ;
	rdfs:label "SIPAddress" ;
	rdfs:subClassOf uco_linkml:DigitalAddress ;
	skos:definition "A SIP address is an identifier for Session Initiation Protocol (SIP) communication." ;
	skos:exactMatch uco-observable:SIPAddress ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:SIPAddressFacet a owl:Class ;
	rdfs:label "SIPAddressFacet" ;
	rdfs:subClassOf uco_linkml:DigitalAddressFacet ;
	skos:definition "A SIP address facet is a grouping of characteristics unique to a Session Initiation Protocol (SIP) standards conformant identifier assigned to a user to enable routing and management of SIP standards conformant communication to or from that user loosely coupled from any particular devices." ;
	skos:exactMatch uco-observable:SIPAddressFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:SMSMessage a owl:Class ;
	rdfs:label "SMSMessage" ;
	rdfs:subClassOf uco_linkml:Message ;
	skos:definition "An SMS message is a message conformant to the short message service (SMS) communication protocol standards." ;
	skos:exactMatch uco-observable:SMSMessage ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:SMSMessageFacet a owl:Class ;
	rdfs:label "SMSMessageFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n180 , _:c14n202 , _:c14n2632 ;
	skos:definition "A SMS message facet is a grouping of characteristics unique to a message conformant to the short message service (SMS) communication protocol standards." ;
	skos:exactMatch uco-observable:SMSMessageFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:SQLiteBlob a owl:Class ;
	rdfs:label "SQLiteBlob" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "An SQLite blob is a blob (binary large object) of data within an SQLite database. [based on https://en.wikipedia.org/wiki/SQLite]" ;
	skos:exactMatch uco-observable:SQLiteBlob ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:SQLiteBlobFacet a owl:Class ;
	rdfs:label "SQLiteBlobFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n123 , _:c14n1399 , _:c14n1490 , _:c14n1505 , _:c14n1604 , _:c14n2184 , _:c14n2195 , _:c14n3420 , _:c14n3489 , _:c14n3673 , _:c14n436 ;
	skos:definition "An SQLite blob facet is a grouping of characteristics unique to a blob (binary large object) of data within an SQLite database. [based on https://en.wikipedia.org/wiki/SQLite]" ;
	skos:exactMatch uco-observable:SQLiteBlobFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:SecurityAppliance a owl:Class ;
	rdfs:label "SecurityAppliance" ;
	rdfs:subClassOf uco_linkml:Appliance ;
	skos:definition "A security appliance is a purpose-built computer with software or firmware that is designed to provide a specific security function to protect computer networks." ;
	skos:exactMatch uco-observable:SecurityAppliance ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:Semaphore a owl:Class ;
	rdfs:label "Semaphore" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A semaphore is a variable or abstract data type used to control access to a common resource by multiple processes and avoid critical section problems in a concurrent system such as a multitasking operating system. [based on https://en.wikipedia.org/wiki/Semaphore_(programming)]" ;
	skos:exactMatch uco-observable:Semaphore ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:SendControlCodeEffectFacet a owl:Class ;
	rdfs:label "SendControlCodeEffectFacet" ;
	rdfs:subClassOf uco_linkml:DefinedEffectFacet , _:c14n2928 , _:c14n3193 , _:c14n3375 ;
	skos:definition "A send control code effect facet is a grouping of characteristics unique to the effects of actions upon observable objects where a control code, or other control-oriented communication signal, is sent to the observable object. An example of this would be an action sending a control code changing the running state of a process." ;
	skos:exactMatch uco-observable:SendControlCodeEffectFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:Server a owl:Class ;
	rdfs:label "Server" ;
	rdfs:subClassOf uco_linkml:Computer ;
	skos:definition "A server is a server rack-mount based computer, minicomputer, supercomputer, etc." ;
	skos:exactMatch uco-observable:Server ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:ShopListing a owl:Class ;
	rdfs:label "ShopListing" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A shop listing is a listing of offered products on an online marketplace/shop." ;
	skos:exactMatch uco-observable:ShopListing ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:SimpleAddressFacet a owl:Class ;
	rdfs:label "SimpleAddressFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1055 , _:c14n108 , _:c14n1118 , _:c14n1159 , _:c14n1230 , _:c14n1240 , _:c14n1267 , _:c14n1429 , _:c14n2001 , _:c14n2732 , _:c14n2805 , _:c14n2908 , _:c14n3439 , _:c14n3587 , _:c14n39 , _:c14n590 , _:c14n870 , _:c14n891 ;
	skos:definition "A simple address facet is a grouping of characteristics unique to a geolocation expressed as an administrative address." ;
	skos:exactMatch uco-location:SimpleAddressFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-location> .
uco_linkml:SimpleNameFacet a owl:Class ;
	rdfs:label "SimpleNameFacet" ;
	rdfs:subClassOf uco_linkml:IdentityFacet , _:c14n1096 , _:c14n1388 , _:c14n2801 , _:c14n2848 , _:c14n364 , _:c14n389 , _:c14n3905 , _:c14n804 ;
	skos:definition "A simple name facet is a grouping of characteristics unique to the personal name (e.g., Dr. John Smith Jr.) held by an identity." ;
	skos:exactMatch uco-identity:SimpleNameFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-identity> .
uco_linkml:SmartDevice a owl:Class ;
	rdfs:label "SmartDevice" ;
	rdfs:subClassOf uco_linkml:Device ;
	skos:definition "A smart device is a microprocessor IoT device that is expected to be connected directly to cloud-based networks or via smartphone" ;
	skos:exactMatch uco-observable:SmartDevice ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:SmartPhone a owl:Class ;
	rdfs:label "SmartPhone" ;
	rdfs:subClassOf uco_linkml:Computer , uco_linkml:MobilePhone , uco_linkml:SmartDevice ;
	skos:definition "A smartphone is a portable device that combines mobile telephone and computing functions into one unit. Examples include iPhone, Samsung Galaxy, Huawei, Blackberry. (Inferred by model and OperatingSystemFacet)" ;
	skos:exactMatch uco-observable:SmartPhone ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:Snapshot a owl:Class ;
	rdfs:label "Snapshot" ;
	rdfs:subClassOf uco_linkml:FileSystemObject ;
	skos:definition "A snapshot is a file system object representing a snapshot of the contents of a part of a file system at a point in time." ;
	skos:exactMatch uco-observable:Snapshot ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:Socket a owl:Class ;
	rdfs:label "Socket" ;
	rdfs:subClassOf uco_linkml:FileSystemObject ;
	skos:definition "A socket is a special file used for inter-process communication, which enables communication between two processes. In addition to sending data, processes can send file descriptors across a Unix domain socket connection using the sendmsg() and recvmsg() system calls. Unlike named pipes which allow only unidirectional data flow, sockets are fully duplex-capable. [based on https://en.wikipedia.org/wiki/Unix_file_types]" ;
	skos:exactMatch uco-observable:Socket ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:SocketAddress a owl:Class ;
	rdfs:label "SocketAddress" ;
	rdfs:subClassOf uco_linkml:Address ;
	skos:definition "A socket address (combining and IP address and a port number) is a composite identifier for a network socket endpoint supporting internet protocol communications." ;
	skos:exactMatch uco-observable:SocketAddress ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:Software a owl:Class ;
	rdfs:label "Software" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "Software is a definitely scoped instance of a collection of data or computer instructions that tell the computer how to work. [based on https://en.wikipedia.org/wiki/Software]" ;
	skos:exactMatch uco-observable:Software ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:SoftwareFacet a owl:Class ;
	rdfs:label "SoftwareFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1153 , _:c14n1472 , _:c14n1586 , _:c14n1779 , _:c14n2 , _:c14n2395 , _:c14n247 , _:c14n2489 , _:c14n2627 , _:c14n2648 , _:c14n3079 , _:c14n3308 , _:c14n552 , _:c14n602 , _:c14n923 ;
	skos:definition "A software facet is a grouping of characteristics unique to a software program (a definitively scoped instance of a collection of data or computer instructions that tell the computer how to work). [based on https://en.wikipedia.org/wiki/Software]" ;
	skos:exactMatch uco-observable:SoftwareFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:StateChangeEffectFacet a owl:Class ;
	rdfs:label "StateChangeEffectFacet" ;
	rdfs:subClassOf uco_linkml:DefinedEffectFacet , _:c14n2354 , _:c14n2789 , _:c14n2963 , _:c14n3087 , _:c14n3787 , _:c14n744 ;
	skos:definition "A state change effect facet is a grouping of characteristics unique to the effects of actions upon observable objects where a state of the observable object is changed." ;
	skos:exactMatch uco-observable:StateChangeEffectFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:StatementMarking dcterms:title "Statement Marking" ;
	a owl:Class ;
	rdfs:label "StatementMarking" ;
	rdfs:subClassOf uco_linkml:MarkingModel , _:c14n1384 , _:c14n1495 , _:c14n1669 , _:c14n3234 , _:c14n3651 , _:c14n3884 ;
	skos:definition "A statement marking is a grouping of characteristics unique to the expression of data marking definitions (restrictions, permissions, and other guidance for how data can be used and shared) to convey details of a textual marking statement, (e.g., copyright) whose semantic meaning should apply to the associated content. Statement markings are generally not machine-readable. An example of this would be a simple marking to apply copyright information, such as 'Copyright 2014 Acme Inc.'." ;
	skos:exactMatch uco-marking:StatementMarking ;
	skos:inScheme <https://w3id.org/lmodel/uco-marking> .
uco_linkml:StorageMedium a owl:Class ;
	rdfs:label "StorageMedium" ;
	rdfs:subClassOf uco_linkml:Device ;
	skos:definition "A storage medium is any digital storage device that applies electromagnetic or optical surfaces, or depends solely on electronic circuits as solid state storage, for storing digital data. Examples include HDD (PATA), SATA, SSD, Optical, Memory_Card, Tape, etc" ;
	skos:exactMatch uco-observable:StorageMedium ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:StorageMediumFacet a owl:Class ;
	rdfs:label "StorageMediumFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1182 , _:c14n3815 , _:c14n956 ;
	skos:definition "A storage medium facet is a grouping of characteristics unique to a the storage capabilities of a piece of equipment or a mechanism designed to serve a special purpose or perform a special function." ;
	skos:exactMatch uco-observable:StorageMediumFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:SymbolicLink a owl:Class ;
	rdfs:label "SymbolicLink" ;
	rdfs:subClassOf uco_linkml:FileSystemObject ;
	skos:definition "A symbolic link is a file that contains a reference to another file or directory in the form of an absolute or relative path and that affects pathname resolution. [based on https://en.wikipedia.org/wiki/Symbolic_link]" ;
	skos:exactMatch uco-observable:SymbolicLink ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:SymbolicLinkFacet a owl:Class ;
	rdfs:label "SymbolicLinkFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n2619 , _:c14n309 , _:c14n3740 ;
	skos:definition "A symbolic link facet is a grouping of characteristics unique to a file that contains a reference to another file or directory in the form of an absolute or relative path and that affects pathname resolution. [based on https://en.wikipedia.org/wiki/Symbolic_link]" ;
	skos:exactMatch uco-observable:SymbolicLinkFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:TCPConnection a owl:Class ;
	rdfs:label "TCPConnection" ;
	rdfs:subClassOf uco_linkml:NetworkConnection ;
	skos:definition "A TCP connection is a network connection that is conformant to the Transfer" ;
	skos:exactMatch uco-observable:TCPConnection ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:TCPConnectionFacet a owl:Class ;
	rdfs:label "TCPConnectionFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1741 , _:c14n2221 , _:c14n2557 , _:c14n3407 ;
	skos:definition "A TCP connection facet is a grouping of characteristics unique to portions of a network connection that are conformant to the Transmission Control Protocl (TCP) standard." ;
	skos:exactMatch uco-observable:TCPConnectionFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:TableField a owl:Class ;
	rdfs:label "TableField" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A database table field and its associated value contained within a relational database." ;
	skos:exactMatch uco-observable:TableField ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:TableFieldFacet a owl:Class ;
	rdfs:label "TableFieldFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1198 , _:c14n1507 , _:c14n1602 , _:c14n1619 , _:c14n1785 , _:c14n2048 , _:c14n2178 , _:c14n2442 , _:c14n2746 , _:c14n3037 , _:c14n366 , _:c14n3682 , _:c14n3683 , _:c14n654 , _:c14n710 , _:c14n784 , _:c14n785 , _:c14n866 ;
	skos:definition "A database record facet contains properties associated with a specific table record value from a database." ;
	skos:exactMatch uco-observable:TableFieldFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:Tablet a owl:Class ;
	rdfs:label "Tablet" ;
	rdfs:subClassOf uco_linkml:Computer , uco_linkml:MobileDevice , uco_linkml:SmartDevice ;
	skos:definition "A tablet is a mobile computer that is primarily operated by touching the screen. (Devices categorized by their manufacturer as a Tablet)" ;
	skos:exactMatch uco-observable:Tablet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:TaskActionType a owl:Class ;
	rdfs:label "TaskActionType" ;
	rdfs:subClassOf uco_linkml:UcoInherentCharacterizationThing , _:c14n1233 , _:c14n1583 , _:c14n1630 , _:c14n174 , _:c14n2099 , _:c14n2584 , _:c14n2693 , _:c14n2995 , _:c14n3065 , _:c14n3097 , _:c14n3344 , _:c14n3467 , _:c14n3909 , _:c14n589 , _:c14n613 , _:c14n663 , _:c14n678 , _:c14n944 ;
	skos:definition "A task action type is a grouping of characteristics for a scheduled action to be completed." ;
	skos:exactMatch uco-observable:TaskActionType ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:Technique a owl:Class ;
	rdfs:label "Technique" ;
	rdfs:subClassOf uco_linkml:UcoType , _:c14n2930 , _:c14n468 ;
	skos:definition "A technique is a class of actions joined by some common characteristics. The class uco-action:Technique is a metaclass. A Technique instance is an owl:Class that is a subclass of uco-action:Action." ;
	skos:exactMatch uco-action:Technique ;
	skos:inScheme <https://w3id.org/lmodel/uco-action> .
uco_linkml:TermsOfUseMarking dcterms:title "Terms Of Use Marking" ;
	a owl:Class ;
	rdfs:label "TermsOfUseMarking" ;
	rdfs:subClassOf uco_linkml:MarkingModel , _:c14n1257 , _:c14n1500 , _:c14n2197 , _:c14n2423 , _:c14n2493 , _:c14n383 ;
	skos:definition "A terms of use marking is a grouping of characteristics unique to the expression of data marking definitions (restrictions, permissions, and other guidance for how data can be used and shared) to convey details of a textual statement specifying the Terms of Use (that is, the conditions under which the content may be shared, applied, or otherwise used) of the marked content. An example of this would be used to communicate a simple statement, such as 'Acme Inc. is not responsible for the content of this file'." ;
	skos:exactMatch uco-marking:TermsOfUseMarking ;
	skos:inScheme <https://w3id.org/lmodel/uco-marking> .
uco_linkml:Thread a owl:Class ;
	rdfs:label "Thread" ;
	rdfs:subClassOf uco_linkml:Bag , uco_linkml:UcoThing , _:c14n1766 , _:c14n1914 , _:c14n2699 , _:c14n3209 , _:c14n34 , _:c14n3427 , _:c14n3452 , _:c14n3759 , _:c14n668 ;
	skos:definition "A semi-ordered array of items, that can be present in multiple copies. Implementation of a UCO Thread is similar to a Collections Ontology List, except a Thread may fork and merge - that is, one of its members may have two or more direct successors, and two or more direct predecessors." ;
	skos:exactMatch uco-types:Thread ;
	skos:inScheme <https://w3id.org/lmodel/uco-types> .
uco_linkml:ThreadItem a owl:Class ;
	rdfs:label "ThreadItem" ;
	rdfs:subClassOf uco_linkml:CoItem , uco_linkml:UcoThing , _:c14n127 , _:c14n1412 , _:c14n144 , _:c14n1640 , _:c14n1900 , _:c14n1972 , _:c14n2185 , _:c14n2548 , _:c14n3769 , _:c14n3851 , _:c14n3888 , _:c14n762 , _:c14n787 , _:c14n837 ;
	skos:definition "A ThreadItem is a member of a thread." ;
	skos:exactMatch uco-types:ThreadItem ;
	skos:inScheme <https://w3id.org/lmodel/uco-types> .
uco_linkml:Tool a owl:Class ;
	rdfs:label "Tool" ;
	rdfs:subClassOf uco_linkml:UcoObject , _:c14n1075 , _:c14n1549 , _:c14n1560 , _:c14n1828 , _:c14n1946 , _:c14n2068 , _:c14n23 , _:c14n2342 , _:c14n2356 , _:c14n2677 , _:c14n3477 , _:c14n3758 , _:c14n3772 , _:c14n797 ;
	skos:definition "A tool is an element of hardware and/or software utilized to carry out a particular function." ;
	skos:exactMatch uco-tool:Tool ;
	skos:inScheme <https://w3id.org/lmodel/uco-tool> .
uco_linkml:TriggerType a owl:Class ;
	rdfs:label "TriggerType" ;
	rdfs:subClassOf uco_linkml:UcoInherentCharacterizationThing , _:c14n128 , _:c14n1380 , _:c14n1671 , _:c14n168 , _:c14n1913 , _:c14n2360 , _:c14n2472 , _:c14n2718 , _:c14n2736 , _:c14n2759 , _:c14n2948 , _:c14n2952 , _:c14n3096 , _:c14n3241 , _:c14n3249 , _:c14n3435 , _:c14n3568 , _:c14n3606 , _:c14n608 , _:c14n623 , _:c14n691 , _:c14n729 , _:c14n746 , _:c14n90 ;
	skos:definition "A trigger type is a grouping of characterizes unique to a set of criteria that, when met, starts the execution of a task within a Windows operating system. [based on https://docs.microsoft.com/en-us/windows/win32/taskschd/task-triggers]" ;
	skos:exactMatch uco-observable:TriggerType ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:Tweet a owl:Class ;
	rdfs:label "Tweet" ;
	rdfs:subClassOf uco_linkml:Message ;
	skos:definition "A tweet is message submitted by a Twitter user account to the Twitter microblogging platform." ;
	skos:exactMatch uco-observable:Tweet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:TwitterProfileFacet a owl:Class ;
	rdfs:label "TwitterProfileFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n11 , _:c14n1123 , _:c14n1130 , _:c14n1207 , _:c14n125 , _:c14n1283 , _:c14n1353 , _:c14n1354 , _:c14n1573 , _:c14n1688 , _:c14n17 , _:c14n1709 , _:c14n1736 , _:c14n1758 , _:c14n2110 , _:c14n2163 , _:c14n2278 , _:c14n2332 , _:c14n2407 , _:c14n2424 , _:c14n2511 , _:c14n2635 , _:c14n2657 , _:c14n2775 , _:c14n2900 , _:c14n294 , _:c14n296 , _:c14n3054 , _:c14n3605 , _:c14n3614 , _:c14n3664 , _:c14n3695 , _:c14n438 , _:c14n490 , _:c14n508 , _:c14n526 , _:c14n583 , _:c14n656 , _:c14n699 , _:c14n734 , _:c14n789 , _:c14n886 , _:c14n930 , _:c14n975 , _:c14n981 ;
	skos:definition "A twitter profile facet is a grouping of characteristics unique to an explicit digital representation of identity and characteristics of the owner of a single Twitter user account. [based on https://en.wikipedia.org/wiki/User_profile]" ;
	skos:exactMatch uco-observable:TwitterProfileFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:UNIXAccount a owl:Class ;
	rdfs:label "UNIXAccount" ;
	rdfs:subClassOf uco_linkml:DigitalAccount ;
	skos:definition "A UNIX account is an account on a UNIX operating system." ;
	skos:exactMatch uco-observable:UNIXAccount ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:UNIXAccountFacet a owl:Class ;
	rdfs:label "UNIXAccountFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1606 , _:c14n1923 , _:c14n227 , _:c14n2999 , _:c14n3669 , _:c14n875 ;
	skos:definition "A UNIX account facet is a grouping of characteristics unique to an account on a UNIX operating system." ;
	skos:exactMatch uco-observable:UNIXAccountFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:UNIXFile a owl:Class ;
	rdfs:label "UNIXFile" ;
	rdfs:subClassOf uco_linkml:File ;
	skos:definition "A UNIX file is a file pertaining to the UNIX operating system." ;
	skos:exactMatch uco-observable:UNIXFile ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:UNIXFilePermissionsFacet a owl:Class ;
	rdfs:label "UNIXFilePermissionsFacet" ;
	rdfs:subClassOf uco_linkml:Facet ;
	skos:definition "A UNIX file permissions facet is a grouping of characteristics unique to the access rights (e.g., view, change, navigate, execute) of a file on a UNIX file system." ;
	skos:exactMatch uco-observable:UNIXFilePermissionsFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:UNIXProcess a owl:Class ;
	rdfs:label "UNIXProcess" ;
	rdfs:subClassOf uco_linkml:Process ;
	skos:definition "A UNIX process is an instance of a computer program executed on a UNIX operating system." ;
	skos:exactMatch uco-observable:UNIXProcess ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:UNIXProcessFacet a owl:Class ;
	rdfs:label "UNIXProcessFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1474 , _:c14n598 , _:c14n724 , _:c14n777 ;
	skos:definition "A UNIX process facet is a grouping of characteristics unique to an instance of a computer program executed on a UNIX operating system." ;
	skos:exactMatch uco-observable:UNIXProcessFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:UNIXVolumeFacet a owl:Class ;
	rdfs:label "UNIXVolumeFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1338 , _:c14n3055 , _:c14n3257 , _:c14n3386 , _:c14n3661 , _:c14n454 ;
	skos:definition "A UNIX volume facet is a grouping of characteristics unique to a single accessible storage area (volume) with a single UNIX file system. [based on https://en.wikipedia.org/wiki/Volume_(computing)]" ;
	skos:exactMatch uco-observable:UNIXVolumeFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:URL a owl:Class ;
	rdfs:label "URL" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A URL is a uniform resource locator (URL) acting as a resolvable address to a particular WWW (World Wide Web) accessible resource." ;
	skos:exactMatch uco-observable:URL ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:URLFacet a owl:Class ;
	rdfs:label "URLFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1025 , _:c14n1037 , _:c14n1135 , _:c14n1486 , _:c14n1592 , _:c14n1737 , _:c14n1764 , _:c14n1927 , _:c14n2154 , _:c14n237 , _:c14n2764 , _:c14n2878 , _:c14n2991 , _:c14n3258 , _:c14n3290 , _:c14n3323 , _:c14n3462 , _:c14n3473 , _:c14n3507 , _:c14n3537 , _:c14n375 , _:c14n3859 , _:c14n434 , _:c14n521 , _:c14n532 , _:c14n820 , _:c14n91 ;
	skos:definition "A URL facet is a grouping of characteristics unique to a uniform resource locator (URL) acting as a resolvable address to a particular WWW (World Wide Web) accessible resource." ;
	skos:exactMatch uco-observable:URLFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:URLHistory a owl:Class ;
	rdfs:label "URLHistory" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A URL history characterizes the stored URL history for a particular web browser" ;
	skos:exactMatch uco-observable:URLHistory ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:URLHistoryEntry dcterms:title "URL History Entry" ;
	a owl:Class ;
	rdfs:label "URLHistoryEntry" ;
	rdfs:subClassOf uco_linkml:UcoInherentCharacterizationThing , _:c14n1059 , _:c14n1091 , _:c14n111 , _:c14n1139 , _:c14n1206 , _:c14n1231 , _:c14n1265 , _:c14n1477 , _:c14n1529 , _:c14n1561 , _:c14n1603 , _:c14n1820 , _:c14n1848 , _:c14n2118 , _:c14n2214 , _:c14n2320 , _:c14n2798 , _:c14n2852 , _:c14n2879 , _:c14n318 , _:c14n3416 , _:c14n343 , _:c14n3481 , _:c14n352 , _:c14n361 , _:c14n3637 , _:c14n3773 , _:c14n3810 , _:c14n753 , _:c14n953 , _:c14n990 ;
	skos:definition "A URL history entry is a grouping of characteristics unique to the properties of a single URL history entry for a particular browser." ;
	skos:exactMatch uco-observable:URLHistoryEntry ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:URLHistoryFacet a owl:Class ;
	rdfs:label "URLHistoryFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1706 , _:c14n186 , _:c14n3212 , _:c14n633 , _:c14n767 ;
	skos:definition "A URL history facet is a grouping of characteristics unique to the stored URL history for a particular web browser" ;
	skos:exactMatch uco-observable:URLHistoryFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:URLVisit a owl:Class ;
	rdfs:label "URLVisit" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A URL visit characterizes the properties of a visit of a URL within a particular browser." ;
	skos:exactMatch uco-observable:URLVisit ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:URLVisitFacet a owl:Class ;
	rdfs:label "URLVisitFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1350 , _:c14n1390 , _:c14n1633 , _:c14n2039 , _:c14n2042 , _:c14n222 , _:c14n2227 , _:c14n2374 , _:c14n2378 , _:c14n2404 , _:c14n2408 , _:c14n2689 , _:c14n2884 , _:c14n3076 , _:c14n32 , _:c14n3253 , _:c14n3757 , _:c14n51 ;
	skos:definition "A URL visit facet is a grouping of characteristics unique to the properties of a visit of a URL within a particular browser." ;
	skos:exactMatch uco-observable:URLVisitFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:UcoDocument a owl:Class ;
	rdfs:label "UcoDocument" ;
	rdfs:subClassOf _:c14n3159 , _:c14n611 ;
	skos:definition "A document of UCO data, as a JSON-LD file of UCO holds one graph." ;
	skos:exactMatch uco_linkml:UcoDocument ;
	skos:inScheme <https://w3id.org/lmodel/uco> .
uco_linkml:UcoInherentCharacterizationThing a owl:Class ;
	rdfs:label "UcoInherentCharacterizationThing" ;
	rdfs:subClassOf uco_linkml:UcoThing ;
	skos:definition "A UCO inherent characterization thing is a grouping of characteristics unique to a particular inherent aspect of a UCO domain object." ;
	skos:exactMatch uco-core:UcoInherentCharacterizationThing ;
	skos:inScheme <https://w3id.org/lmodel/uco-core> .
uco_linkml:UcoObject a owl:Class ;
	rdfs:label "UcoObject" ;
	rdfs:subClassOf uco_linkml:UcoThing , _:c14n1121 , _:c14n1508 , _:c14n1537 , _:c14n1546 , _:c14n1547 , _:c14n1618 , _:c14n1699 , _:c14n175 , _:c14n1791 , _:c14n1883 , _:c14n1903 , _:c14n2372 , _:c14n2441 , _:c14n2510 , _:c14n2602 , _:c14n2638 , _:c14n28 , _:c14n2803 , _:c14n2850 , _:c14n3003 , _:c14n3204 , _:c14n3220 , _:c14n335 , _:c14n349 , _:c14n3689 , _:c14n3742 , _:c14n3824 , _:c14n408 , _:c14n615 , _:c14n717 ;
	skos:definition "A UCO object is a representation of a fundamental concept either directly inherent to the cyber domain or indirectly related to the cyber domain and necessary for contextually characterizing cyber domain concepts and relationships. Within the Unified Cyber Ontology (UCO) structure this is the base class acting as a consistent, unifying and interoperable foundation for all explicit and inter-relatable content objects." ;
	skos:exactMatch uco-core:UcoObject ;
	skos:inScheme <https://w3id.org/lmodel/uco-core> .
uco_linkml:UcoThing a owl:Class ;
	rdfs:label "UcoThing" ;
	rdfs:seeAlso uco-core:UcoThing-identifier-regex-shape ;
	rdfs:subClassOf _:c14n161 , _:c14n2063 , _:c14n3411 ;
	skos:definition "UcoThing is the top-level class for individuals within UCO." ;
	skos:exactMatch uco-core:UcoThing ;
	skos:inScheme <https://w3id.org/lmodel/uco-core> .
uco_linkml:UcoType a owl:Class ;
	rdfs:label "UcoType" ;
	rdfs:subClassOf _:c14n117 , _:c14n1478 , _:c14n2456 , _:c14n2861 , _:c14n3134 , _:c14n3422 ;
	skos:definition "UcoType is the top-level class for metaclasses within UCO. An instance of core:UcoType is also an instance of owl:Class, and is or specializes core:UcoThing." ;
	skos:exactMatch uco-core:UcoType ;
	skos:inScheme <https://w3id.org/lmodel/uco-core> .
uco_linkml:UserAccount a owl:Class ;
	rdfs:label "UserAccount" ;
	rdfs:subClassOf uco_linkml:DigitalAccount ;
	skos:definition "A user account is an account controlling a user's access to a network, system or platform." ;
	skos:exactMatch uco-observable:UserAccount ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:UserAccountFacet a owl:Class ;
	rdfs:label "UserAccountFacet" ;
	rdfs:subClassOf uco_linkml:Facet , _:c14n1232 , _:c14n1290 , _:c14n1829 , _:c14n2814 , _:c14n3005 , _:c14n337 , _:c14n3392 , _:c14n3670 , _:c14n373 , _:c14n412 , _:c14n42 , _:c14n893 ;
	skos:definition "A user account facet is a grouping of characteristics unique to an account controlling a user's access to a network, system, or platform." ;
	skos:exactMatch uco-observable:UserAccountFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
