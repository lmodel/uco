uco_linkml:isSecure a owl:DatatypeProperty ;
	rdfs:label "isSecure" ;
	rdfs:range xsd:boolean ;
	skos:definition "Is the cookie secure? If the cookie is secure it cannot be delivered over an unencrypted session such as http." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
