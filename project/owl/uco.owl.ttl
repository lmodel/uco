	rdfs:label "accountType" ;
	rdfs:range _:c14n2675 ;
	rdfs:subPropertyOf uco_linkml:informalType ;
	skos:definition "The type of account, for instance bank, phone, application, service, etc." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
