uco_linkml:longitude a owl:DatatypeProperty ;
	rdfs:label "longitude" ;
	rdfs:range xsd:decimal ;
	skos:definition "The longitude coordinate of a geolocation." ;
	skos:inScheme <https://w3id.org/lmodel/uco-location> .
uco_linkml:lookupDate a owl:DatatypeProperty ;
	rdfs:label "lookupDate" ;
	rdfs:range xsd:dateTime ;
