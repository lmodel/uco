	rdfs:label "WindowsPEOptionalHeader" ;
	rdfs:subClassOf uco_linkml:UcoInherentCharacterizationThing , _:c14n1114 , _:c14n1140 , _:c14n1246 , _:c14n1256 , _:c14n1259 , _:c14n1408 , _:c14n1569 , _:c14n1868 , _:c14n1881 , _:c14n1932 , _:c14n1938 , _:c14n1939 , _:c14n1958 , _:c14n2072 , _:c14n2109 , _:c14n229 , _:c14n2362 , _:c14n2433 , _:c14n2488 , _:c14n2558 , _:c14n2603 , _:c14n2604 , _:c14n271 , _:c14n2810 , _:c14n2834 , _:c14n287 , _:c14n2964 , _:c14n2968 , _:c14n297 , _:c14n306 , _:c14n31 , _:c14n324 , _:c14n3322 , _:c14n3362 , _:c14n3364 , _:c14n3400 , _:c14n3409 , _:c14n3417 , _:c14n3456 , _:c14n3482 , _:c14n3591 , _:c14n3613 , _:c14n3624 , _:c14n3680 , _:c14n3722 , _:c14n395 , _:c14n545 , _:c14n603 , _:c14n618 , _:c14n704 , _:c14n782 , _:c14n796 , _:c14n799 , _:c14n811 , _:c14n892 , _:c14n902 , _:c14n97 , _:c14n977 ;
	skos:definition "A Windows PE optional header is a grouping of characteristics unique to the 'optional header' of a Windows PE (Portable Executable) file, consisting of a collection of metadata about the executable code structure of the file." ;
	skos:exactMatch uco-observable:WindowsPEOptionalHeader ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:WindowsPESection a owl:Class ;
	rdfs:label "WindowsPESection" ;
	rdfs:subClassOf uco_linkml:UcoInherentCharacterizationThing , _:c14n1 , _:c14n1119 , _:c14n1556 , _:c14n1700 , _:c14n1853 , _:c14n2094 , _:c14n218 , _:c14n2760 , _:c14n3227 , _:c14n3372 , _:c14n96 ;
