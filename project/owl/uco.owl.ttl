	skos:exactMatch uco-identity:NationalityFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-identity> .
uco_linkml:NetworkAppliance a owl:Class ;
	rdfs:label "NetworkAppliance" ;
	rdfs:subClassOf uco_linkml:Appliance ;
