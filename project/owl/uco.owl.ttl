	skos:definition "An NTFS file facet is a grouping of characteristics unique to a file on an NTFS (new technology filesystem) file system." ;
	skos:exactMatch uco-observable:NTFSFileFacet ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:NTFSFilePermissionsFacet a owl:Class ;
	rdfs:label "NTFSFilePermissionsFacet" ;
	rdfs:subClassOf uco_linkml:Facet ;
