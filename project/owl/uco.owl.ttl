<https://w3id.org/lmodel/uco.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://github.com/ucoProject/UCO/releases/tag/1.5.0> ;
	dcterms:title "Unified Cyber Ontology (UCO)" ;
	pav:version "1.5.0" ;
	a owl:Ontology ;
	rdfs:label "uco" ;
	rdfs:seeAlso <https://lmodel.github.io/uco> , <https://unifiedcyberontology.org/releases/1.5.0/> ;
	skos:definition "A LinkML rendering of the Unified Cyber Ontology (UCO) 1.5.0: one module per UCO namespace and one for the Collections Ontology terms UCO uses, with every class, property and vocabulary keeping its UCO IRI." ;
	skos:note "Declared in uco_core although their IRIs are in UCO's types namespace, since Event's eventAttribute ranges over them and uco-core imports no other UCO namespace: Dictionary (uco-types:Dictionary), entry (uco-types:entry), DictionaryEntry (uco-types:DictionaryEntry), key (uco-types:key), types_value (uco-types:value)." , "Each module imports the modules its UCO file imports, and this file imports them in that order, so an importer can import one module alone." , "Left out: SHACL advice (severity sh:Info or sh:Warning), SPARQL constraints, sh:not, sh:xone, paths of more than one property, shapes on a property's objects, that hasFacet is inverse functional, and UCO's rule that a UcoThing is never a blank node, which a facet inlined here is when written as RDF." , "The descriptions are UCO's rdfs:comment texts, which the UCO Community publishes under the Apache License 2.0." , "Where UCO defines one local name in more than one namespace, the namespace that comes first in this file's imports keeps it, and each other takes its namespace as a prefix: action_endTime, action_object, action_startTime, action_value, marking_statement, observable_context, observable_cpeid, observable_creator, observable_endTime, observable_eventType, observable_key, observable_location, observable_modifiedTime, observable_participant, observable_references, observable_startTime, observable_swid, observable_value, observable_version, types_value." , "scripts/uco_to_linkml.py writes every YAML file in this folder from UCO's files in upstream/. Change the script or the copy, never the files." .
uco_linkml:API a owl:Class ;
	rdfs:label "API" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "An API (application programming interface) is a computing interface that defines interactions between multiple software or mixed hardware-software intermediaries. It defines the kinds of calls or requests that can be made, how to make them, the data formats that should be used, the conventions to follow, etc. [based on https://en.wikipedia.org/wiki/API]" ;
	skos:exactMatch uco-observable:API ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:ARPCache a owl:Class ;
	rdfs:label "ARPCache" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "An ARP cache is a collection of Address Resolution Protocol (ARP) entries (mostly dynamic) that are created when an IP address is resolved to a MAC address (so the computer can effectively communicate with the IP address). [based on https://en.wikipedia.org/wiki/ARP_cache]" ;
	skos:exactMatch uco-observable:ARPCache ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:ARPCacheEntry a owl:Class ;
	rdfs:label "ARPCacheEntry" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "An ARP cache entry is a single Address Resolution Protocol (ARP) response record that is created when an IP address is resolved to a MAC address (so the computer can effectively communicate with the IP address). [based on https://en.wikipedia.org/wiki/ARP_cache]" ;
	skos:exactMatch uco-observable:ARPCacheEntry ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:Account a owl:Class ;
	rdfs:label "Account" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "An account is an arrangement with an entity to enable and control the provision of some capability or service." ;
	skos:exactMatch uco-observable:Account ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
