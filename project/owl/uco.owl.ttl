	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:WebPage a owl:Class ;
	rdfs:label "WebPage" ;
	rdfs:subClassOf uco_linkml:ObservableObject ;
	skos:definition "A web page is a specific collection of information provided by a website and displayed to a user in a web browser. A website typically consists of many web pages linked together in a coherent fashion. [based on https://en.wikipedia.org/wiki/Web_page]" ;
	skos:exactMatch uco-observable:WebPage ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
