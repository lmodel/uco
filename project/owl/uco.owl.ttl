uco_linkml:majorSubsystemVersion a owl:DatatypeProperty ;
	rdfs:label "majorSubsystemVersion" ;
	rdfs:range xsd:unsignedShort ;
	skos:definition "Specifies the major version number of the subsystem." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:manuallyEnteredCount dcterms:title "Manually-Entered Count" ;
	a owl:DatatypeProperty ;
	rdfs:label "manuallyEnteredCount" ;
	rdfs:range xsd:nonNegativeInteger ;
	skos:definition "Specifies the number of times the URL referred to by the URL field was manually entered into the browser's address field by the user. This field is only applicable for URL history entries generated by Google's Chrome browser." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:manufacturer a owl:ObjectProperty ;
	rdfs:label "manufacturer" ;
	rdfs:range uco_linkml:Identity ;
	skos:definition "UCO 1.5.0 declares the property uco-observable:manufacturer without a definition." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:marking a owl:ObjectProperty ;
	rdfs:label "marking" ;
	rdfs:range uco_linkml:MarkingDefinition ;
	skos:definition "Represents specific marking definitions to be applied to UCO data." ;
	skos:inScheme <https://w3id.org/lmodel/uco-marking> .
uco_linkml:marking_statement dcterms:title "Statement" ;
	a owl:DatatypeProperty ;
	rdfs:label "marking_statement" ;
	rdfs:range xsd:string ;
	skos:definition "Specifies the statement to apply to the structure for which the Marking is to be applied." ;
