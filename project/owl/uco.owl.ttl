	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
uco_linkml:accountLogin a owl:DatatypeProperty ;
	rdfs:label "accountLogin" ;
	rdfs:range xsd:string ;
	skos:definition "The login identifier for the digital account." ;
	skos:inScheme <https://w3id.org/lmodel/uco-observable> .
