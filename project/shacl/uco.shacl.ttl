	sh:targetClass uco-observable:ARPCache .
uco-observable:ARPCacheEntry a sh:NodeShape ;
	rdfs:comment "An ARP cache entry is a single Address Resolution Protocol (ARP) response record that is created when an IP address is resolved to a MAC address (so the computer can effectively communicate with the IP address). [based on https://en.wikipedia.org/wiki/ARP_cache]" ;
	sh:closed true ;
